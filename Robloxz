        capDotRingStroke.Transparency = 0.15 + ringProg * 0.85
    end

    for _, pdata in ipairs(particles) do
        local t = rClk * pdata.speed + pdata.phase
        pdata.inst.Position = UDim2.fromScale(
            pdata.baseX + math.sin(t) * pdata.amp,
            pdata.baseY + math.cos(t * 0.7) * pdata.amp
        )
    end

    syncShadow()

    if expandedWrap.Visible then
        local pct = math.floor(math.clamp(progFill.Size.X.Scale * 100, 0, 100) + 0.5)
        if pct ~= lastPct then
