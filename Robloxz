local function updateStatusPill(newText, isReady)
    if not tpTxt or not tpTxt.Parent then return end
    tw(tpTxt, 0.11, Enum.EasingStyle.Quad, nil, { TextTransparency = 0.7 })
    tw(topPillScale, 0.14, Enum.EasingStyle.Back, nil, { Scale = 1.05 })
    task.delay(0.10, function()
        if not tpTxt or not tpTxt.Parent then return end
        tpTxt.Text = sc(newText)
        if isReady then
            local green = rgb(45, 235, 135)
            tw(tpTxt, 0.18, Enum.EasingStyle.Quad, nil, { TextColor3 = green })
            tw(statusDot, 0.18, Enum.EasingStyle.Quad, nil, { BackgroundColor3 = green })
            tw(tpStroke, 0.18, Enum.EasingStyle.Quad, nil, { Color = green })
        end
        tw(tpTxt, 0.15, Enum.EasingStyle.Quad, nil, { TextTransparency = 0 })
        tw(topPillScale, 0.18, Enum.EasingStyle.Quint, nil, { Scale = 1.0 })
    end)
end

