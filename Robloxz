local SmallCapsMap = {
    a = "ᴀ", b = "ʙ", c = "ᴄ", d = "ᴅ", e = "ᴇ", f = "ꜰ", g = "ɢ", h = "ʜ",
    i = "ɪ", j = "ᴊ", k = "ᴋ", l = "ʟ", m = "ᴍ", n = "ɴ", o = "ᴏ", p = "ᴩ",
    q = "ǫ", r = "ʀ", s = "ꜱ", t = "ᴛ", u = "ᴜ", v = "ᴠ", w = "ᴡ", x = "x",
    y = "ʏ", z = "ᴢ"
}
local function sc(str)
    if not str then return "" end
    return (tostring(str):lower():gsub("%a", function(ch)
        return SmallCapsMap[ch] or ch
    end))
end

local function playUiTick(id, vol, pitch)
    task.spawn(function()
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = id
            s.Volume = vol or 0.45
            s.PlaybackSpeed = pitch or 1
            s.Parent = Svc.Sound
            s:Play()
            task.delay(1.8, function() pcall(function() s:Destroy() end) end)
        end)
    end)
end

