local function build(t, map)
    local res = ""
    for i = 1, #t do
        local c = t:sub(i,i):lower()
        res = res .. (map[c] or c)
    end
    return res
end

local FONTS = {
    {F = function(t) return "🕷️ " .. build(t, Maps.Cyrillic):upper() .. " 🕷️" end},
