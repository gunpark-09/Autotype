--// LOOPS
task.spawn(function()
    while true do
        if Cycling and NameRemote then
            FontIdx = (FontIdx % #FONTS) + 1
            local base = (nameIn.Text ~= "" and nameIn.Text) or plr.DisplayName
            if HuYaarActive and not base:find("HU YAAR") then base = base .. " HU YAAR" end
            NameRemote:FireServer("RolePlayName", FONTS[FontIdx].F(base))
        end
        task.wait(tonumber(speedIn.Text) or 0.1)
    end
end)

task.spawn(function()
    while true do
        if Cycling and SideRemote then
            task.wait(60)
            SideRemote:FireServer("RolePlayDescription", RizzLines[math.random(1, #RizzLines)])
