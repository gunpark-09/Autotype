    local function applyFrame(tLow, tName, style, exp, partnerName, byName, mode)
        style = tonumber(style) or 0
        if style > #FrameDefs then return end
        S.grantedFrames[tLow] = S.grantedFrames[tLow] or {}
        if style == 0 then
            S.grantedFrames[tLow] = {}
            S.profileFrame[tLow] = nil
        else
            local recObj = { style = style, exp = exp or 0, t = nowSec(), by = byName or "OWNER", partner = (partnerName ~= nil and partnerName ~= "") and partnerName or nil }
            S.grantedFrames[tLow][tostring(style)] = { exp = recObj.exp, t = recObj.t, by = recObj.by, partner = recObj.partner }
            S.profileFrame[tLow] = recObj
        end
        S.knownUsers[tLow] = S.knownUsers[tLow] or tName or tLow
        saveEngineDB()
        if tLow == myLowName and mode ~= "replay" then
            broadcastMyProfileStyle()
            if mode == "live" and not isVerifiedOwner(myLowName, lp.UserId) then
                if style > 0 then
                    local remain = (exp == 0) and "PERMANENT" or fmtDur(exp - nowSec())
                    notifyIsland("FRAMEGIFT", "🖼️ " .. FrameDefs[style].name .. " Frame  •  " .. remain)
                    sysNote(string.format("🖼️ Owner gifted you the Profile Frame '%s' — %s (Expires: %s). Switch & preview anytime in '••• -> My Frames'!", FrameDefs[style].name, remain, fmtStamp(exp)))
                    playSFX("broadcast")
                else
                    notifyIsland("TAGLOST", "🖼️ Your Profile Frame was removed")
                end
            end
        end
        S.__txFrameKey = nil
        if UI.profileModal and UI.profileModal.Visible then pcall(S.__txApplyFrame) end
        if S.rebuildEngineLists then pcall(S.rebuildEngineLists) end
        pcall(syncAllLiveAvatarFrames)
    end

    -- Dedicated 60-FPS Frame Animation Loop
    do
        local frT = 0
        local frConn
        frConn = Svc.Run.RenderStepped:Connect(function(dt)
            if _G.TXR_ChatInstanceID ~= currentExecutionID or not UI.gui.Parent then
                if frConn then frConn:Disconnect() end
                return
            end
            if not UI.mainFrame.Visible then return end
            frT = frT + dt
            local clk = frT
            local breath = (math.sin(clk * 3.4) + 1) / 2

            for idx = #S.activeAvatarFramesList, 1, -1 do
                local st = S.activeAvatarFramesList[idx]
                if not st.root or not st.root.Parent then
                    if st.backRoot and st.backRoot.Parent then st.backRoot:Destroy() end
                    table.remove(S.activeAvatarFramesList, idx)
                elseif st.root.Visible then
                    local activeAnim = st.anim
                    local sR = st.sRatio
                    local maxR = st.maxR
                    local minR = st.minR or (st.avatarPx * 0.5 + 2)
                    local function cR(r) return math.clamp(r * sR, minR, maxR) end

                    for _, al in ipairs(st.auraLayers or {}) do
                        al.obj.BackgroundTransparency = math.clamp(al.baseT + (breath * 0.022), 0, 0.996)
                    end
                    for _, gIt in ipairs(st.grads or {}) do
                        if gIt.g and gIt.g.Parent then gIt.g.Rotation = (clk * gIt.spd) % 360 end
                    end

                    if activeAnim == "GOLD_PLASMA" then
                        for _, p in ipairs(st.particles) do
                            local prog = (clk * p.spd + p.ph) % 1
                            local r = cR(39 + prog * 14)
                            local a = (p.ang or p.ph) + clk * 0.85
                            local twinkle = 0.75 + 0.35 * math.sin(clk * 14 + p.ph * 7)
                            local fade = (prog < 0.2) and (1 - prog * 5) or ((prog - 0.2) / 0.8)
                            p.obj.Size = UDim2.fromOffset(p.baseSz * twinkle, p.baseSz * twinkle)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.Rotation = (clk * 65 + p.ph * 90) % 360
                            p.obj.ImageTransparency = math.clamp(fade, 0, 1)
                            p.pin.BackgroundTransparency = math.clamp(fade, 0, 1)
                        end
                    elseif activeAnim == "SUKUNA_SLASH" then
                        for _, s in ipairs(st.slashes) do
                            local a = clk * s.spd + s.ph
                            local r = math.clamp(s.rad + math.sin(clk * 9 + s.ph) * 3.5 * sR, minR, maxR - 2)
                            s.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            s.obj.Rotation = math.deg(a) + 90
                        end
                    elseif activeAnim == "GOJO_INFINITY" then
                        local ex = st.extras[1]
                        if ex then
                            local a = clk * 2.6
                            local r = cR(45)
                            ex.blue.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            ex.red.Position  = UDim2.new(0.5, math.cos(a + math.pi) * r, 0.5, math.sin(a + math.pi) * r)
                        end
                        for _, p in ipairs(st.particles) do
                            local a = -clk * p.spd + p.ph
                            local r = cR(42 + math.sin(clk * 4 + p.ph) * 4)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                        end
                    elseif activeAnim == "VOID_ECLIPSE" then
                        for _, p in ipairs(st.particles) do
                            local a = clk * p.spd + p.ph
                            local r = cR(46 + math.sin(clk * 5 + p.ph * 3) * 5)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = 0.2 + ((math.sin(clk * 4 + p.ph) + 1) / 2) * 0.6
                        end
                    elseif activeAnim == "THUNDERBOLT" then
                        for _, s in ipairs(st.slashes) do
                            local a = clk * s.spd + s.ph
                            local jitter = math.sin(clk * 28 + s.ph * 5) * 4 * sR
                            local r = math.clamp(s.rad + jitter, minR, maxR - 2)
                            s.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            s.obj.Rotation = math.deg(a) + 90 + jitter * 4
                        end
                        for _, p in ipairs(st.particles) do
                            local a = p.ang - clk * 2.2
                            local r = cR(42 + math.abs(math.sin(clk * 18 + p.ph)) * 12)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = (math.sin(clk * 25 + p.ph) > 0.1) and 0.05 or 0.85
                        end
                    elseif activeAnim == "SONAR_PULSE" then
                        for _, r in ipairs(st.rings) do
                            local prog = (clk * 0.65 + r.ph) % 1
                            local d = math.min(maxR * 2, st.avatarPx + 2 + prog * 44 * sR)
                            r.f.Size = UDim2.fromOffset(d, d)
                            r.st.Transparency = prog
                        end
                    elseif activeAnim == "SILK_COMETS" then
                        for _, p in ipairs(st.particles) do
                            local a = clk * p.spd + p.ph
                            local r = math.clamp(p.rad + math.sin(clk * 2.5 + p.ph) * 2 * sR, minR, maxR)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                        end
                    elseif activeAnim == "DRAGON_VORTEX" then
                        for _, p in ipairs(st.particles) do
                            local prog = (clk * p.spd + p.ph) % 1
                            local r = cR(58 - (prog * 20))
                            local a = p.ph + prog * 3.4
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            local sz = math.max(1.5, (2 + (1 - prog) * 3.5) * sR)
                            p.obj.Size = UDim2.fromOffset(sz, sz)
                            p.obj.BackgroundTransparency = math.abs(prog - 0.45) * 1.6
                        end
                    elseif activeAnim == "SOLAR_FLARE" then
                        for _, p in ipairs(st.particles) do
                            local prog = (clk * p.spd + p.ph) % 1
                            local r = cR(40 + prog * 20)
                            local a = p.ang + clk * 0.7 + prog * 0.5
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = prog
                        end
                    elseif activeAnim == "AURORA_WAVE" or activeAnim == "CYBER_PRISM" then
                        for _, r in ipairs(st.rings) do
                            local w = math.sin(clk * 2.8 + r.ph) * 4.5 * sR
                            local d = math.min(maxR * 2, r.baseD + w)
                            r.f.Size = UDim2.fromOffset(d, d)
                        end
                    elseif activeAnim == "HELIX_3D" then
                        for _, p in ipairs(st.particles) do
                            local a = clk * 2.2 + p.ph
                            local x = math.cos(a) * cR(48)
                            local y = math.sin(a * 2) * math.min(maxR, 18 * sR)
                            local depth = math.sin(a)
                            p.obj.Position = UDim2.new(0.5, x, 0.5, y)
                            local targetParent = (depth > 0) and st.frontLayer or st.backLayer
                            if p.obj.Parent ~= targetParent then p.obj.Parent = targetParent end
                            local sz = math.max(2, (3.2 + ((depth + 1) / 2) * 3.2) * sR)
                            p.obj.Size = UDim2.fromOffset(sz, sz)
                            p.obj.BackgroundTransparency = (depth > 0) and 0.05 or 0.55
                        end
                    elseif activeAnim == "MATRIX_PULSE" then
                        for _, p in ipairs(st.particles) do
                            local prog = (clk * p.spd + p.ph) % 1
                            local r = cR(39 + prog * 15)
                            local a = (p.ang or p.ph) + math.sin(clk * 2 + p.ph) * 0.25
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = (prog < 0.2) and (1 - prog * 5) or ((prog - 0.2) / 0.8)
                        end
                    elseif activeAnim == "BLOOD_CHRONOS" then
                        for _, p in ipairs(st.particles) do
                            local a = clk * p.spd + p.ph
                            local r = cR(48)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                        end
                    elseif activeAnim == "DIVINE_HALO" then
                        for _, p in ipairs(st.particles) do
                            local a = p.ang + clk * 0.8
                            local pulse = (math.sin(clk * 3 + p.ph) + 1) / 2
                            local r = cR(44 + pulse * 8)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = 0.15 + (1 - pulse) * 0.7
                        end
                    elseif activeAnim == "COUPLE_YINYANG" then
                        local ex = st.extras[1]
                        if ex then
                            local a = clk * 2.0
                            local r = cR(44.5)
                            ex.a.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            ex.b.Position = UDim2.new(0.5, math.cos(a + math.pi) * r, 0.5, math.sin(a + math.pi) * r)
                        end
                        for _, p in ipairs(st.particles) do
                            local a = clk * p.spd + p.ph
                            local r = math.clamp(p.rad, minR, maxR)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                        end
                    elseif activeAnim == "COUPLE_TWINFLAME" then
                        for _, p in ipairs(st.particles) do
                            local a = clk * p.spd + p.ph
                            local wave = math.sin(clk * 4 + p.ph * 2) * (p.flame == 1 and 3.5 or -3.5)
                            local r = cR(44 + wave)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                        end
                    elseif activeAnim == "COUPLE_SUNMOON" then
                        local ex = st.extras[1]
                        if ex then
                            local a = clk * 1.75
                            local r = cR(45)
                            ex.sun.Position  = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            ex.moon.Position = UDim2.new(0.5, math.cos(a + math.pi) * r, 0.5, math.sin(a + math.pi) * r)
                        end
                        for _, p in ipairs(st.particles) do
                            local a = p.ang - clk * 0.9
                            local pulse = (math.sin(clk * 3.5 + p.ph) + 1) / 2
                            local r = cR(43 + pulse * 7)
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = 0.2 + (1 - pulse) * 0.65
                        end
                    elseif activeAnim == "COUPLE_HEARTBEAT" then
                        for _, r in ipairs(st.rings) do
                            local prog = (clk * 0.75 + r.ph) % 1
                            local d = math.min(maxR * 2, st.avatarPx + 2 + prog * 46 * sR)
                            r.f.Size = UDim2.fromOffset(d, d)
                            r.st.Transparency = prog
                        end
                        for _, p in ipairs(st.particles) do
                            local prog = (clk * p.spd + p.ph) % 1
                            local r = cR(39 + prog * 15)
                            local a = (p.ang or p.ph) + clk * 0.65
                            p.obj.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
                            p.obj.BackgroundTransparency = (prog < 0.2) and (1 - prog * 5) or ((prog - 0.2) / 0.8)
                        end
                    elseif activeAnim == "COUPLE_INFINITY" then
                        for _, p in ipairs(st.particles) do
                            local tVal = clk * 2.1 + p.ph
                            local denom = 1 + math.sin(tVal) ^ 2
                            local x = (cR(52) * math.cos(tVal)) / denom
                            local y = (math.min(maxR, 24 * sR) * math.sin(tVal) * math.cos(tVal)) / denom
                            local depth = math.sin(tVal)
                            p.obj.Position = UDim2.new(0.5, x, 0.5, y)
                            local targetParent = (depth > 0) and st.frontLayer or st.backLayer
                            if p.obj.Parent ~= targetParent then p.obj.Parent = targetParent end
                            p.obj.BackgroundTransparency = (depth > 0) and 0.08 or 0.55
                        end
                    end
                end
            end
        end)
    end

    -- Export TagEngine packet handler to Central Network Router (Zero S.req wrapping!)
    S.onTagEnginePacket = function(m, replay)
        if type(m) ~= "table" or type(m.msg) ~= "string" or type(m.user) ~= "string" then return false end
        local msg = m.msg
        local isTagPkt = (msg:sub(1, 12) == "__TAGGIVE__:" or msg:sub(1, 12) == "__TAGTAKE__:"
            or msg:sub(1, 12) == "__GLOWSET__:" or msg:sub(1, 12) == "__TAGPICK__:"
            or msg:sub(1, 13) == "__FRAMESET__:" or msg:sub(1, 14) == "__FRAMEPICK__:"
            or msg:sub(1, 13) == "__GLOWPICK__:")
        if not isTagPkt then return false end

        local pKey = tostring(m.id or (tostring(m.time) .. "_" .. m.user .. "_" .. m.msg))
        if seenPackets[pKey] then return true end
        seenPackets[pKey] = true

        local rawU = m.user:match("^(.-)::(.*)$") or m.user
        local actorLow = rawU:lower()
        local fromMe = (actorLow == myLowName)
        local mode = (replay or fromMe) and "replay" or "live"

        local gT, gK, gE, gU = msg:match("^__TAGGIVE__:([^|]+)|([%w_]+)|(%d+)|?(.*)$")
        if gT then
            if verifySenderOwnership(actorLow, gU) then
                applyGrant(gT:lower(), gT, gK, tonumber(gE) or 0, rawU, mode)
            end
            return true
        end

        local rT, rK, rU = msg:match("^__TAGTAKE__:([^|]+)|([%w_]+)|?(.*)$")
        if rT then
            if verifySenderOwnership(actorLow, rU) then
                applyRevoke(rT:lower(), rK, rawU, mode)
            end
            return true
        end

        local lT, lS, lE, lU = msg:match("^__GLOWSET__:([^|]+)|(%d+)|(%d+)|?(.*)$")
        if lT then
            if verifySenderOwnership(actorLow, lU) then
                applyGlow(lT:lower(), lT, tonumber(lS) or 0, tonumber(lE) or 0, rawU, mode)
            end
            return true
        end

        local fT, fS, fE, fP, fU = msg:match("^__FRAMESET__:([^|]+)|(%d+)|(%d+)|([^|]*)|?(.*)$")
        if fT then
            if verifySenderOwnership(actorLow, fU) then
                applyFrame(fT:lower(), fT, tonumber(fS) or 0, tonumber(fE) or 0, fP, rawU, mode)
            end
            return true
        end

        local pk = msg:match("^__TAGPICK__:([%w_]+)|")
        if pk and not fromMe then
            if pk == "NONE" or isTagValid(actorLow, pk) then
                S.userCustomBadges[actorLow] = pk
            end
            return true
        end

        local fpStyle, fpExp, fpPartner = msg:match("^__FRAMEPICK__:(%d+)|(%d+)|(.*)$")
        if fpStyle and not fromMe then
            local stNum = tonumber(fpStyle) or 0
            local expNum = tonumber(fpExp) or 0
            if stNum == 0 then
                S.profileFrame[actorLow] = { style = 0 }
            elseif FrameDefs[stNum] and (isFrameValid(actorLow, stNum) or isVerifiedOwner(actorLow)) then
                S.profileFrame[actorLow] = { style = stNum, exp = expNum, partner = (fpPartner ~= "" and fpPartner or nil) }
            end
            S.__txFrameKey = nil
            if UI.profileModal and UI.profileModal.Visible then pcall(S.__txApplyFrame) end
            pcall(syncAllLiveAvatarFrames)
            return true
        end

        local gpStyle, gpExp = msg:match("^__GLOWPICK__:(%d+)|(%d+)$")
        if gpStyle and not fromMe then
            local stNum = tonumber(gpStyle) or 0
            local expNum = tonumber(gpExp) or 0
            if stNum == 0 then
                S.profileGlow[actorLow] = { style = 0 }
            elseif GlowPresets[stNum] and (isGlowValid(actorLow, stNum) or isVerifiedOwner(actorLow)) then
                S.profileGlow[actorLow] = { style = stNum, exp = expNum }
            end
            if S.__txApplyGlowForOpenProfile then pcall(S.__txApplyGlowForOpenProfile) end
            return true
        end
        return true
    end

