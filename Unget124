    openDmConversationRoom = function(targetUser, targetDisp)
        if not targetUser or targetUser == "" then return end
        local conv = ensureConversationRecord(targetUser, targetDisp)
        if not conv then return end

        S.activeDmChatUser = conv.user
        S.privateTarget = conv.user
        conv.unread = 0
        saveDmDatabase()
        getTotalUnreadDms()

        for _, child in ipairs(UI.messageFeed:GetChildren()) do
            if child:IsA("GuiObject") and child:GetAttribute("ChatScope") == "dm" then
                child:Destroy()
            end
        end

        for _, mRec in ipairs(conv.messages) do
            local isMeSender = (tostring(mRec.sender):lower() == myLow)
            local senderTag = isMeSender and (lp.Name .. "::" .. lp.DisplayName) or (conv.user .. "::" .. conv.disp)
            addMessageToFeed(senderTag, mRec.msg, conv.user, isMeSender, game.JobId, "dm", mRec.timeStr, mRec.id)
        end

        if S.chatMode ~= "dm" then
            S.switchChatTab("dm")
        else
            UI.dmInboxView.Visible = false
            UI.messageFeed.Visible = true
            UI.inputContainer.Visible = true
            UI.messageFeed.Position = UDim2.new(0, 12, 0, 126)
            UI.messageFeed.Size = UDim2.new(1, -24, 1, S.activeReplyData and -220 or -188)
            refreshDmHeaderControls()
            scrollToFeedBottom()
        end
        playSFX("dm")
    end
    S.openDmConversationRoom = openDmConversationRoom

