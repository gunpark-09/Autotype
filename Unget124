    local function applyGrant(tLow, tName, key, exp, byName, mode)
        if not BadgePresets[key] or key == "AICORE" then return end
        S.grantedTags[tLow] = S.grantedTags[tLow] or {}
        S.grantedTags[tLow][key] = { exp = exp or 0, t = nowSec(), by = byName or "OWNER" }
        S.knownUsers[tLow] = S.knownUsers[tLow] or tName or tLow
        S.userCustomBadges[tLow] = key
        if tLow == myLowName and mode ~= "replay" then
            S.currentOwnerBadge = key
            saveProfilePrefs()
            broadcastMyProfileStyle()
            if mode == "live" and not isVerifiedOwner(myLowName, lp.UserId) then
                local tTitle = BadgePresets[key].Title
                local remain = (exp == 0) and "PERMANENT" or fmtDur(exp - nowSec())
                notifyIsland("TAGGIFT", "🎁 " .. tTitle .. "  •  " .. remain)
                sysNote(string.format("🎁 Owner (%s) gifted you the %s tag — %s (Expires: %s). Manage it in the 'Live Tags' menu.", tostring(byName), tTitle, remain, fmtStamp(exp)))
                playSFX("broadcast")
            end
        else
            saveEngineDB()
        end
        refreshAll()
    end

    local function applyRevoke(tLow, key, byName, mode)
        local map = S.grantedTags[tLow]
        local removedKeys = {}
        if map then
            for k, _ in pairs(map) do
                if key == "ALL" or k == key then
                    table.insert(removedKeys, k)
                end
            end
            for _, k in ipairs(removedKeys) do map[k] = nil end
        end
        local cur = S.userCustomBadges[tLow]
        if cur and (key == "ALL" or cur == key) and not isVerifiedOwner(tLow) then
            local nxt = validTagList(tLow)[1]
            S.userCustomBadges[tLow] = nxt and nxt.key or nil
        end
        if tLow == myLowName and #removedKeys > 0 and mode ~= "replay" then
            local curMine = S.currentOwnerBadge
            local wasRemoved = false
            for _, k in ipairs(removedKeys) do if k == curMine then wasRemoved = true end end
            if wasRemoved then
                local nxt = validTagList(myLowName)[1]
                S.currentOwnerBadge = nxt and nxt.key or "NONE"
                S.userCustomBadges[myLowName] = S.currentOwnerBadge
            end
            saveProfilePrefs()
            broadcastMyProfileStyle()
            if mode == "live" and not isVerifiedOwner(myLowName, lp.UserId) then
                notifyIsland("TAGLOST", "🗑️ Owner revoked your " .. ((key == "ALL") and "tags" or tostring(BadgePresets[key] and BadgePresets[key].Title or key)))
                sysNote("🗑️ The Owner has revoked your gifted tag(s).")
            end
        else
            saveEngineDB()
        end
        refreshAll()
    end

    local function applyGlow(tLow, tName, style, exp, byName, mode)
        style = tonumber(style) or 0
        if style > #GlowPresets then return end
        S.grantedGlows[tLow] = S.grantedGlows[tLow] or {}
        if style == 0 then
            S.grantedGlows[tLow] = {}
            if isVerifiedOwner(tLow) then S.profileGlow[tLow] = { style = 0 } else S.profileGlow[tLow] = nil end
        else
            S.grantedGlows[tLow][tostring(style)] = { exp = exp or 0, t = nowSec(), by = byName or "OWNER" }
            S.profileGlow[tLow] = { style = style, exp = exp or 0, t = nowSec(), by = byName or "OWNER" }
        end
        S.knownUsers[tLow] = S.knownUsers[tLow] or tName or tLow
        saveEngineDB()
        if tLow == myLowName and mode ~= "replay" then
            broadcastMyProfileStyle()
            if mode == "live" and not isVerifiedOwner(myLowName, lp.UserId) then
                if style > 0 then
                    local remain = (exp == 0) and "PERMANENT" or fmtDur(exp - nowSec())
                    notifyIsland("GLOWGIFT", "✨ " .. GlowPresets[style].name .. " Glow  •  " .. remain)
                    sysNote(string.format("✨ Owner gifted you the Premium Profile Glow '%s' — %s (Expires: %s). Switch anytime in '••• -> My Glows'!", GlowPresets[style].name, remain, fmtStamp(exp)))
                    playSFX("broadcast")
                else
                    notifyIsland("TAGLOST", "✨ Your Premium Profile Glow was removed")
                end
            end
        end
        refreshAll()
    end

