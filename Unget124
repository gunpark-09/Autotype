                UI.chatInput.Text = ""
                UI.chatInput.TextEditable = false
                UI.chatInput.PlaceholderText = "🚫 " .. sc("YOU BLOCKED THIS USER (TAP UNBLOCK)")
                UI.chatInput.PlaceholderColor3 = Colors.Danger
