            end
        end
        return
    end

    local unmuteTarget = text:match("^!unmute%s+@?([%w_]+)")
    if unmuteTarget then
        UI.chatInput.Text = ""
        if isOwner then
            setGlobalMuteState(unmuteTarget, false, true)
            addMessageToFeed("System::" .. BRAND_TITLE, "🔊 @" .. unmuteTarget .. " has been UNMUTED and can chat again.", nil, false, game.JobId, currentScope)
        end
        return
    end

    local pMatch = text:match("^!p%s+(%w+)")
    if pMatch then
        UI.chatInput.Text = ""; S.privateTarget = pMatch; S.updateInputBar()
        switchChatTab("dm")
        addMessageToFeed("System::" .. BRAND_TITLE, "Direct DM channel locked with @" .. pMatch, nil, false, game.JobId, "dm")
        return
    end

    if lowText == "/help" or lowText == "!help" then
        UI.chatInput.Text = ""
        local helpStr = "Commands: '@ai <msg>' for Live AI | '!p <user>' for Private DM | Double-Tap any message to Heart."
        if isOwner then
            helpStr = helpStr .. " | Owner: '!mute <user>' & '!unmute <user>' | Open any profile & tap '👑 +FOL' to inject unlimited rich followers!"
        end
        addMessageToFeed("System::" .. BRAND_TITLE, helpStr, nil, false, game.JobId, currentScope)
        return
    end

    if S.activeEditData then
        local formattedBody = sanitizeXml(text)
        formattedBody = formattedBody:gsub("(@%w+)", "<font color='#FFCD46'><b>%1</b></font>")
        S.activeEditData.label.Text = formattedBody .. "  <font color='#8A9AB5' size='9'><i>(" .. sc("edited") .. ")</i></font>"
        clearReplyBanner()
        UI.chatInput.Text = ""
        playSFX("default")
        return
    end

    local payloadBodyText = text
    if S.activeReplyData then
        payloadBodyText = string.format("[REP:%s|%s] %s", S.activeReplyData.disp, S.activeReplyData.text, text)
        clearReplyBanner()
    end

    local finalMsg = payloadBodyText

    if S.privateTarget then
        finalMsg = "( 🔐 " .. lp.Name .. " Private " .. S.privateTarget .. ") " .. payloadBodyText
        currentScope = "dm"
        if S.chatMode ~= "dm" then switchChatTab("dm") end
    else
        if currentScope == "dm" then
            addMessageToFeed("System::" .. BRAND_TITLE, "Select a player first via Profile -> DM or type '!p <username>'.", nil, false, game.JobId, "dm")
            return
        end
        finalMsg = (currentScope == "server") and ("[SRV:" .. tostring(game.JobId) .. "] " .. payloadBodyText) or ("[GLB] " .. payloadBodyText)
    end

    if not overrideText then UI.chatInput.Text = "" end
    local encodedUserTag = lp.Name .. "::" .. lp.DisplayName
    local genMsgId = encodedUserTag .. "_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999)) .. "_" .. payloadBodyText

