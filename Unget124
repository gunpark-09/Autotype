    -- ---------- packet processing (hooked on the existing /messages poll) ----------
    local function processPacket(m, replay)
        if type(m) ~= "table" or type(m.msg) ~= "string" or type(m.user) ~= "string" then return end
        local pKey = tostring(m.id or (tostring(m.time) .. "_" .. m.user .. "_" .. m.msg))
        if seenPackets[pKey] then return end
        seenPackets[pKey] = true

        local rawU = m.user:match("^(.-)::(.*)$") or m.user
        local actorLow = rawU:lower()
        local fromMe = (actorLow == myLowName)
        local mode = (replay or fromMe) and "replay" or "live"
        local msg = m.msg

        local gT, gK, gE, gU = msg:match("^__TAGGIVE__:([^|]+)|([%w_]+)|(%d+)|?(.*)$")
        if gT then
            if verifySenderOwnership(actorLow, gU) then
                applyGrant(gT:lower(), gT, gK, tonumber(gE) or 0, rawU, mode)
            end
            return
        end

        local rT, rK, rU = msg:match("^__TAGTAKE__:([^|]+)|([%w_]+)|?(.*)$")
        if rT then
            if verifySenderOwnership(actorLow, rU) then
                applyRevoke(rT:lower(), rK, rawU, mode)
            end
            return
        end

        local lT, lS, lE, lU = msg:match("^__GLOWSET__:([^|]+)|(%d+)|(%d+)|?(.*)$")
        if lT then
            if verifySenderOwnership(actorLow, lU) then
                applyGlow(lT:lower(), lT, tonumber(lS) or 0, tonumber(lE) or 0, rawU, mode)
            end
            return
        end

        local fT, fS, fE, fP, fU = msg:match("^__FRAMESET__:([^|]+)|(%d+)|(%d+)|([^|]*)|?(.*)$")
        if fT then
            if verifySenderOwnership(actorLow, fU) then
                applyFrame(fT:lower(), fT, tonumber(fS) or 0, tonumber(fE) or 0, fP, rawU, mode)
            end
            return
        end

        local pk = msg:match("^__TAGPICK__:([%w_]+)|")
        if pk and not fromMe then
            if pk == "NONE" or isTagValid(actorLow, pk) then
                S.userCustomBadges[actorLow] = pk
            end
            return
        end
    end

    local origReq = S.req
    if origReq then
        S.req = function(opts, ...)
            local res = origReq(opts, ...)
            pcall(function()
                if type(opts) == "table" and type(opts.Url) == "string" and opts.Method == "GET"
                    and opts.Url:find("/messages?since=", 1, true)
                    and res and (res.StatusCode == 200 or res.Status == 200) and res.Body then
                    local ok, data = pcall(function() return Svc.Http:JSONDecode(res.Body) end)
                    if ok and type(data) == "table" then
                        local replay = not firstBatchSeen
                        firstBatchSeen = true
                        local mine = {}
                        for _, m in ipairs(data) do
                            if type(m) == "table" and type(m.msg) == "string" then
                                local p = m.msg:sub(1, 11)
                                if p == "__TAGGIVE__:" or m.msg:sub(1, 12) == "__TAGGIVE__:" or m.msg:sub(1, 12) == "__TAGTAKE__:"
                                    or m.msg:sub(1, 12) == "__GLOWSET__:" or m.msg:sub(1, 12) == "__TAGPICK__:" or m.msg:sub(1, 13) == "__FRAMESET__:" then
                                    table.insert(mine, m)
                                end
                            end
                        end
                        if #mine > 0 then
                            task.delay(0.05, function()
                                for _, m in ipairs(mine) do pcall(processPacket, m, replay) end
                            end)
                        end
                    end
                end
            end)
            return res
        end
    end

