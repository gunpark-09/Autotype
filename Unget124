local function setGlobalMuteState(targetUsername, muteBool, broadcastToNet)
    if not targetUsername or targetUsername == "" then return end
    local tLow = targetUsername:lower()
    if tLow == "system" or isVerifiedOwner(tLow) then return end

    if muteBool then
        S.mutedUsers[tLow] = true
    else
        S.mutedUsers[tLow] = nil
    end
    saveProfilePrefs()

    if tLow == lp.Name:lower() and S.updateMuteLockUI then
        S.updateMuteLockUI()
    end
    if S.refreshMuteStudioUI then
        S.refreshMuteStudioUI()
    end
    if S.refreshProfileSocialUI then
        S.refreshProfileSocialUI()
    end

    if broadcastToNet and isVerifiedOwner(lp.Name:lower(), lp.UserId) then
        task.spawn(function()
            if S.req then
                pcall(function()
                    S.req({
                        Url = S.SERVER_URL .. "/send", Method = "POST",
