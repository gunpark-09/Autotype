local function refreshAutoComplete(rawText)
    for _, c in ipairs(acScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local cmdPrefix = rawText:match("^([!/][%w_]*)$")
    local dmUserPrefix = rawText:match("^!p%s+([%w_]*)$")
    local muteUserPrefix = rawText:match("^!mute%s+([%w_]*)$")
    local unmuteUserPrefix = rawText:match("^!unmute%s+([%w_]*)$")
    local mentionPrefix = rawText:match("@([%w_]*)$")
    local suggestions = {}

    if cmdPrefix then
        local q = cmdPrefix:sub(2):lower()
        local cmds = {
            { label = "!help  •  " .. sc("Commands"), fill = "!help" },
            { label = "@ai  •  " .. sc("Ask Live AI"), fill = "@ai " },
            { label = "!p <user>  •  " .. sc("Direct DM"), fill = "!p " }
        }
        if isVerifiedOwner(lp.Name:lower(), lp.UserId) then
            table.insert(cmds, { label = "!mute <user>  •  " .. sc("Mute Player"), fill = "!mute " })
            table.insert(cmds, { label = "!unmute <user>  •  " .. sc("Unmute Player"), fill = "!unmute " })
        end
        for _, item in ipairs(cmds) do
            if q == "" or item.fill:lower():find(q, 1, true) then table.insert(suggestions, { text = item.label, replaceMode = "full", val = item.fill }) end
        end
    elseif dmUserPrefix ~= nil or muteUserPrefix ~= nil or unmuteUserPrefix ~= nil or mentionPrefix ~= nil then
        local q = (dmUserPrefix or muteUserPrefix or unmuteUserPrefix or mentionPrefix or ""):lower()
        local modeKind = dmUserPrefix and "dm" or (muteUserPrefix and "mute" or (unmuteUserPrefix and "unmute" or "mention"))
        local seen = {}

        if modeKind == "mention" then
            if q == "" or ("ai"):find(q, 1, true) then
                table.insert(suggestions, { text = "@ai  •  " .. sc("Ask Live AI"), replaceMode = "mention", val = "@ai " })
            end
            if isVerifiedOwner(lp.Name:lower(), lp.UserId) then
                if q == "" or ("all"):find(q, 1, true) then
                    table.insert(suggestions, { text = "@all  •  " .. sc("Admin Broadcast"), replaceMode = "mention", val = "@all " })
                end
                if q == "" or ("here"):find(q, 1, true) then
                    table.insert(suggestions, { text = "@here  •  " .. sc("Active Alert"), replaceMode = "mention", val = "@here " })
                end
            end
        end

        for _, info in pairs(S.activeUsersTable) do
            if type(info) == "table" and info.user then
                local uName, dName = info.user, info.disp
                if uName:lower() ~= lp.Name:lower() and not seen[uName:lower()] and uName:lower() ~= "system" then
                    if q == "" or uName:lower():find(q, 1, true) or dName:lower():find(q, 1, true) then
                        seen[uName:lower()] = true
                        local fillVal = (modeKind == "dm" and ("!p " .. uName .. " "))
                            or (modeKind == "mute" and ("!mute " .. uName))
                            or (modeKind == "unmute" and ("!unmute " .. uName))
                            or ("@" .. uName .. " ")
                        table.insert(suggestions, {
                            text = "@ " .. dName,
                            replaceMode = modeKind,
                            val = fillVal
                        })
                    end
                end
            end
        end
    end

    if #suggestions > 0 and S.chatMode ~= "rank" and S.chatMode ~= "extra" then
        for i = 1, math.min(8, #suggestions) do
            local s = suggestions[i]
            local chip = mk("TextButton", acScroll, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 22), BackgroundColor3 = Colors.ActiveTint, BackgroundTransparency = 0.20, Text = "  " .. s.text .. "  ", TextColor3 = Colors.Primary, Font = Enum.Font.GothamBlack, TextSize = 9.5, AutoButtonColor = false, ZIndex = 30, Corner = UDim.new(1, 0), Stroke = { Color = Colors.PrimaryDark, Thickness = 1, Transparency = 0.45 } })
            applySpringHover(chip)
            chip.MouseButton1Click:Connect(function()
                if s.replaceMode == "mention" then 
                    UI.chatInput.Text = string.gsub(UI.chatInput.Text, "@[%w_]*$", s.val) 
                else
                    UI.chatInput.Text = s.val
                end
                UI.autoCompleteBar.Visible = false
                task.defer(function()
                    UI.chatInput.CursorPosition = #UI.chatInput.Text + 1
                    UI.chatInput:CaptureFocus()
                end)
            end)
        end
        if not UI.autoCompleteBar.Visible then
            UI.autoCompleteBar.Visible = true; acScale.Scale = 0.94
            Svc.Tween:Create(acScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end
    else
        UI.autoCompleteBar.Visible = false
    end
end

