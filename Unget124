    local function getFrameRec(low)
        if not low then return nil end
        local rec = S.profileFrame[low]
        if rec and rec.style == 0 then return nil end
        if rec and rec.style and rec.style > 0 and FrameDefs[rec.style] and (not rec.exp or rec.exp == 0 or rec.exp > nowSec()) then
            return rec
        end
        local fList = validFrameList(low)
        if fList[1] then
            local fallback = { style = fList[1].key, exp = fList[1].rec.exp, by = fList[1].rec.by, partner = fList[1].rec.partner }
            S.profileFrame[low] = fallback
            return fallback
        end
        return nil
    end
    S.__txGetFrameRec = getFrameRec

    local function makeEnergyArc(parent, diameter, thick, seq, transSeq, z)
        local ring = mk("Frame", parent, {
            Size = UDim2.fromOffset(diameter, diameter), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            BackgroundTransparency = 1, ZIndex = z, Corner = UDim.new(1, 0)
        })
        local st = mk("UIStroke", ring, { Thickness = thick, Color = Color3.new(1, 1, 1), ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
        local gr = mk("UIGradient", st, { Color = seq, Transparency = transSeq })
        return ring, st, gr
    end

