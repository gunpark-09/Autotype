    moveConn = Svc.UIS.InputChanged:Connect(function(input)
        if _G.TXR_ChatInstanceID ~= currentExecutionID or not card or not card.Parent then
            if moveConn then moveConn:Disconnect() end
            return
        end
        if isSwipingCard and (input == swipeInputObj or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - swipeStartPos
            movedDistance = delta.Magnitude
            if S.activeReactionMenu then return end
            if delta.X > 6 and math.abs(delta.X) > math.abs(delta.Y) * 1.25 then
                isHoldingCard = false
                local dragOffset = math.clamp((math.max(0, delta.X - 6)) ^ 0.85 * 1.35, 0, 58)
                card.Position = UDim2.fromOffset(dragOffset, 0)
                local progress = math.clamp(dragOffset / 40, 0, 1)
                swipeCapsule.BackgroundTransparency = 1 - (progress * 0.90)
                scFill.Size = UDim2.fromScale(progress, 1)
                scStroke.Transparency = 1 - progress
                swipeLabel.TextTransparency = 1 - progress
                scScale.Scale = 0.65 + (progress * 0.40)

                if dragOffset >= 40 and not swipeTriggered then
                    swipeTriggered = true; scFill.BackgroundColor3 = Colors.Purple; playSFX("default")
                elseif dragOffset < 40 and swipeTriggered then
                    swipeTriggered = false; scFill.BackgroundColor3 = Colors.Primary
                end
            end
        end
    end)

    endConn = Svc.UIS.InputEnded:Connect(function(input)
        if _G.TXR_ChatInstanceID ~= currentExecutionID or not card or not card.Parent then
            if endConn then endConn:Disconnect() end
            return
        end
        if isHoldingCard and (input == swipeInputObj or input.UserInputType == Enum.UserInputType.MouseButton1) then
            isHoldingCard = false
            S.activeReactionDragState = nil
            S.reactionCanvasLockPos = nil
            if S.activeReactionMenu and movedDistance > 10 then
                local emojiCont = S.activeReactionMenu:FindFirstChild("EmojiContainer")
                if emojiCont then
                    local bestChild, bestScale = nil, 1.15
                    for _, child in ipairs(emojiCont:GetChildren()) do
                        if child:IsA("TextButton") then
                            local btnScale = child:FindFirstChildOfClass("UIScale")
                            if btnScale and btnScale.Scale > bestScale then
                                bestScale = btnScale.Scale
                                bestChild = child
                            end
                        end
                    end
                    if bestChild then
                        if bestChild.Text == "+" then
                            openCustomEmojiPickerForReaction()
                        else
                            addReactionToCard(bestChild.Text, false)
                            closeReactionMenu()
                        end
                        return
                    end
                end
            end
        end

        if isSwipingCard and (input == swipeInputObj or input.UserInputType == Enum.UserInputType.MouseButton1) then
            isSwipingCard, swipeInputObj = false, nil
            if not S.activeReactionMenu then
                Svc.Tween:Create(card, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.fromOffset(0, 0)}):Play()
                Svc.Tween:Create(swipeCapsule, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
                Svc.Tween:Create(scStroke, TweenInfo.new(0.22), {Transparency = 1}):Play()
                Svc.Tween:Create(swipeLabel, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
                Svc.Tween:Create(scScale, TweenInfo.new(0.22), {Scale = 0.5}):Play()
            end

            if swipeTriggered then
                swipeTriggered = false
                if S.activateReplyBanner then
                    local cleanPreview = isAnyMeme and "[Meme Sticker]" or displayMsg
                    if #cleanPreview > 38 then cleanPreview = string.sub(cleanPreview, 1, 38) .. "..." end
                    S.activateReplyBanner(dispName, cleanPreview)
                end
            elseif movedDistance < 10 and not S.activeReactionMenu and not S.activeSelfMenu then
                if isSelf or isSystemAI then return end
                for _, c in ipairs(UI.actionMenu:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
                createActionBtn("REPLY", Colors.Primary, function()
                    if S.activateReplyBanner then
                        local cleanPreview = isAnyMeme and "[Meme Sticker]" or displayMsg
                        if #cleanPreview > 38 then cleanPreview = string.sub(cleanPreview, 1, 38) .. "..." end
                        S.activateReplyBanner(dispName, cleanPreview)
                    end
                end)
                createActionBtn("DM", Colors.Purple, function()
                    S.privateTarget = actualUsername
                    if S.updateInputBar then S.updateInputBar() end
                    if S.switchChatTab then S.switchChatTab("dm") end
                    playSFX("dm")
                end)
                createActionBtn("COPY", Colors.Text, function() pcall(function() S.setClip(webMemeUrlMatch or (memeIdMatch and ("ID: " .. memeIdMatch)) or displayMsg) end) end)
                createActionBtn("TP", Colors.MentionGold, function()
                    local targetPlr = findPlayerCI(actualUsername)
                    if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        lp.Character.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame
                    end
                end)
                if isVerifiedOwner(lp.Name:lower(), lp.UserId) and not isAdminUser then
                    local isTgtMuted = (S.mutedUsers[lowUser] == true)
                    createActionBtn(isTgtMuted and "UNMT" or "MUTE", isTgtMuted and Colors.OnlineGreen or Colors.Danger, function()
