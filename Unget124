local function broadcastReactionPacket(msgId, emojiStr, isRemoving)
    if not msgId or msgId == "" then return end
    sendNetworkPacket({ user = lp.Name .. "::" .. lp.DisplayName, msg = string.format("%s:%s|%s", isRemoving and "__UNREACT__" or "__REACT__", tostring(msgId), tostring(emojiStr)), jobId = game.JobId, hidden = true })
end

local function addMessageToFeed(rawUserName, msg, privateUserTarget, isPrivateSender, msgJobId, scopeType, customTimeStr, explicitMsgId)
