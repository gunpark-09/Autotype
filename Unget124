            Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Rotation = deg, BackgroundTransparency = 1, ZIndex = zBase + 3
        })
        local pill = mk("Frame", spoke, {
            Size = UDim2.fromOffset(2.4, 7.2), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 1),
            BackgroundColor3 = rgb(0, 230, 195), BackgroundTransparency = (i - 1) / numBlades,
            BorderSizePixel = 0, ZIndex = zBase + 4, Corner = UDim.new(1, 0)
        })
        table.insert(blades, pill)
    end

    local coreDot = mk("Frame", wheel, {
        Size = UDim2.fromOffset(5, 5), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        BackgroundColor3 = rgb(0, 230, 195), BackgroundTransparency = 0.15, ZIndex = zBase + 5, Corner = UDim.new(1, 0)
    })

    local lbl = mk("TextLabel", holder, {
        Size = UDim2.new(1, -16, 0, 16), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.41, 25),
        BackgroundTransparency = 1, Text = sc(labelText or "Loading..."), TextColor3 = rgb(185, 204, 232),
        Font = Enum.Font.GothamBold, TextSize = 9.5, ZIndex = zBase + 3
    })
    mk("UIStroke", lbl, { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.45 })

    table.insert(S.activeSpinnersList, {
        holder = holder,
        blades = blades,
        haloGrad = haloGrad,
        haloStroke = haloStroke,
        coreDot = coreDot,
        lbl = lbl
    })
    return holder, lbl
end

