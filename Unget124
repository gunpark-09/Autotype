    local function searchLiveWebMemes(customQuery, appendNextBatch)
        S.memeSearchToken += 1
        local myToken = S.memeSearchToken

        local queryText = (customQuery or memeSearchBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if queryText:match("^https?://") then
            memeSearchBox.Text = ""
            closeMemeStudio()
            if S.sendMessageFunc then
                S.sendMessageFunc(string.format("[WEBMEME:%s]", queryText))
            end
            return
        end

        local qLow = queryText:lower()
        local seenKeys = {}

        if not appendNextBatch then
            S.liveWebMemes = {}
            S.memePageIdx = 1
            S.memeWebOffset = 1

            for _, item in ipairs(VerifiedMemePool) do
                local catOk = (S.memeFilterCat == "ALL") or (item.cat == S.memeFilterCat)
                local textOk = (qLow == "") or item.name:lower():find(qLow, 1, true) or (item.tags and item.tags:find(qLow, 1, true))
                if catOk and textOk then
                    local k = tostring(item.assetId or item.url)
                    if not seenKeys[k] then
                        seenKeys[k] = true
                        table.insert(S.liveWebMemes, item)
                    end
                end
            end

            if S.memeFilterCat ~= "INDIAN" then
                for _, m in ipairs(S.imgflipPool) do
                    if m and m.url and not seenKeys[m.url] then
                        if qLow == "" or tostring(m.name):lower():find(qLow, 1, true) then
                            seenKeys[m.url] = true
                            table.insert(S.liveWebMemes, { name = tostring(m.name), url = m.url, cat = "GLOBAL" })
                        end
                    end
                end
            end

            renderCurrentMemePage()
        else
            for _, item in ipairs(S.liveWebMemes) do
                seenKeys[tostring(item.assetId or item.url)] = true
            end
        end

        local pinQuery = queryText
        if pinQuery == "" then
            if S.memeFilterCat == "INDIAN" then
                pinQuery = "indian funny memes reaction viral"
            elseif S.memeFilterCat == "GLOBAL" then
                pinQuery = "funny memes reaction templates viral"
            else
                pinQuery = "viral funny memes trending"
            end
        else
            if S.memeFilterCat == "INDIAN" then
                pinQuery = queryText .. " indian meme viral"
            else
                pinQuery = queryText .. " meme viral"
            end
        end

        if #S.liveWebMemes == 0 or appendNextBatch then
            memeSpinnerLbl.Text = sc(appendNextBatch and "Loading more..." or "Searching memes...")
            memeSpinnerOverlay.Visible = true
        end

        fetchPinterestBatch(pinQuery, S.memeWebOffset, function(urls)
            if S.memeSearchToken ~= myToken then return end
            memeSpinnerOverlay.Visible = false
            local addedCount = 0
            for _, cleanUrl in ipairs(urls) do
                if not seenKeys[cleanUrl] then
                    seenKeys[cleanUrl] = true
                    addedCount += 1
                    table.insert(S.liveWebMemes, {
                        name = (queryText ~= "" and queryText or "Meme") .. " #" .. tostring(#S.liveWebMemes + 1),
                        url = cleanUrl
                    })
                end
            end
            S.memeWebOffset += 36
            if appendNextBatch and addedCount > 0 then
                S.memePageIdx += 1
            end
            renderCurrentMemePage()
        end, function()
            return S.memeSearchToken == myToken
        end)
    end

