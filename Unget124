    local function renderFollowersLeaderboard()
        local usersSet, myLow = {}, lp.Name:lower()
        usersSet[myLow] = { lowU = myLow, user = lp.Name, disp = lp.DisplayName }
        for _, plr in ipairs(Svc.Players:GetPlayers()) do local pLow = plr.Name:lower(); S.userIdCache[pLow] = plr.UserId; usersSet[pLow] = { lowU = pLow, user = plr.Name, disp = plr.DisplayName } end
        for uLow, info in pairs(S.activeUsersTable) do if uLow ~= "system" then usersSet[uLow] = { lowU = uLow, user = (type(info) == "table" and info.user) or uLow, disp = (type(info) == "table" and info.disp) or S.knownDispNames[uLow] or uLow } end end
        for uLow, _ in pairs(S.socialGraph.knownCountCache) do if uLow ~= "system" and not usersSet[uLow] then usersSet[uLow] = { lowU = uLow, user = S.knownUsers[uLow] or uLow, disp = S.knownDispNames[uLow] or S.knownUsers[uLow] or uLow } end end

        local sorted = {}
        for _, entry in pairs(usersSet) do entry.followers = getVisualFollowerCount(entry.lowU); entry.sortScore = getFollowerCountForUser(entry.lowU); table.insert(sorted, entry) end
        table.sort(sorted, function(a, b) if a.sortScore == b.sortScore then if a.lowU == myLow then return true end; if b.lowU == myLow then return false end; return a.disp:lower() < b.disp:lower() end; return a.sortScore > b.sortScore end)

        local topScore = math.max(1, sorted[1] and sorted[1].followers or 1)
        for place = 1, 3 do
            local slot, pData = podiumSlots[place], sorted[place]
            slot.data = pData
            if pData then
                local shortDisp = pData.disp; if #shortDisp > 12 then shortDisp = string.sub(shortDisp, 1, 11) .. ".." end
                slot.name.Text = shortDisp; slot.name.TextColor3 = Color3.new(1, 1, 1); slot.tick.Visible = isVerifiedOwner(pData.lowU, S.userIdCache[pData.lowU])
                slot.score.Text = string.format("%d %s", pData.followers, sc("FOL")); slot.score.TextColor3 = (pData.followers < 0) and Colors.Danger or FollowerTop5Themes[place].border
                bindAvatarToImage(pData.lowU, pData.user, slot.avatar)
                if S.attachAvatarFrame then S.attachAvatarFrame(slot.avatar, pData.lowU, slot.avSize, 22) end
            else
                slot.name.Text = sc("OPEN SLOT"); slot.name.TextColor3 = Colors.SubText; slot.tick.Visible = false; slot.score.Text = "0 " .. sc("FOL")
                slot.avatar.Image = "rbxthumb://type=AvatarHeadShot&id=9685785248&w=100&h=100"
                if S.attachAvatarFrame then S.attachAvatarFrame(slot.avatar, nil, slot.avSize, 22) end
