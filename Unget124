        actualUsername = rawUserName
        local targetPlr = findPlayerCI(rawUserName)
        dispName = targetPlr and targetPlr.DisplayName or rawUserName
    end

    local isSystemAI = (actualUsername == "System")
    if isSystemAI then dispName = BRAND_TITLE end

    local lowUser = actualUsername:lower()
    if not isSystemAI and not isVerifiedOwner(lowUser) and S.mutedUsers[lowUser] then return end

    local msgSyncKey = explicitMsgId or (actualUsername .. "_" .. displayMsg:sub(1, 24))
    local cleanSigKey = lowUser .. "::" .. tostring(displayMsg)
    if S.deletedMsgIds[msgSyncKey] or S.deletedMsgSigs[cleanSigKey] then return end

    S.userMsgCounts[lowUser] = (S.userMsgCounts[lowUser] or 0) + 1
