local SmallCapsMap = {
    a = "ᴀ", b = "ʙ", c = "ᴄ", d = "ᴅ", e = "ᴇ", f = "ꜰ", g = "ɢ", h = "ʜ",
    i = "ɪ", j = "ᴊ", k = "ᴋ", l = "ʟ", m = "ᴍ", n = "ɴ", o = "ᴏ", p = "ᴩ",
    q = "ǫ", r = "ʀ", s = "ꜱ", t = "ᴛ", u = "ᴜ", v = "ᴠ", w = "ᴡ", x = "x",
    y = "ʏ", z = "ᴢ"
}
local function sc(str)
    if not str then return "" end
    return (tostring(str):lower():gsub("%a", function(ch)
        return SmallCapsMap[ch] or ch
    end))
end

local ReverseSmallCapsMap = {
    ["ᴀ"] = "a", ["ʙ"] = "b", ["ᴄ"] = "c", ["ᴅ"] = "d", ["ᴇ"] = "e", ["ꜰ"] = "f", ["ɢ"] = "g", ["ʜ"] = "h",
    ["ɪ"] = "i", ["ᴊ"] = "j", ["ᴋ"] = "k", ["ʟ"] = "l", ["ᴍ"] = "m", ["ɴ"] = "n", ["ᴏ"] = "o", ["ᴩ"] = "p",
    ["ǫ"] = "q", ["ʀ"] = "r", ["ꜱ"] = "s", ["ᴛ"] = "t", ["ᴜ"] = "u", ["ᴠ"] = "v", ["ᴡ"] = "w", ["ʏ"] = "y", ["ᴢ"] = "z"
}
local function cleanPureAlphabetName(rawDisp, fallbackUser)
    if not rawDisp or rawDisp == "" then return fallbackUser or "Player" end
    local res = tostring(rawDisp)
    for scChar, normChar in pairs(ReverseSmallCapsMap) do
        res = res:gsub(scChar, normChar)
    end
    res = res:gsub("[^%a%s]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if res == "" then
        local fb = tostring(fallbackUser or "Player"):gsub("[^%a%s]", "")
        return (fb ~= "" and fb) or "Player"
    end
    return res:sub(1, 1):upper() .. res:sub(2)
end

