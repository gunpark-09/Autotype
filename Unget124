    S.attachAvatarFrame = function(avatarImgObj, userLower, avatarPx, zBase)
        if not avatarImgObj or not avatarImgObj.Parent then return end
        local parentHost = avatarImgObj.Parent
        for _, ch in ipairs(parentHost:GetChildren()) do
            if ch.Name == "TXR_ActiveAvatarFrame_Back" or ch.Name == "TXR_ActiveAvatarFrame_Front" then
                ch:Destroy()
            end
        end
        for _, ch in ipairs(avatarImgObj:GetChildren()) do
            if ch.Name == "TXR_ActiveAvatarFrame" or ch.Name == "TXR_ActiveAvatarFrame_Back" or ch.Name == "TXR_ActiveAvatarFrame_Front" then
                ch:Destroy()
            end
        end

        local rec = userLower and getFrameRec(userLower)
        if not rec then return end
        local fd = FrameDefs[rec.style]
        if not fd then return end

        local avZ = math.max(12, avatarImgObj.ZIndex or 14)
        local zBehind = avZ - 2
        local zFront = avZ + 1

        if parentHost:IsA("GuiObject") and parentHost.Name ~= "AvatarSafeZone" then
            parentHost.ClipsDescendants = false
        end

        local maxLim = (avatarPx <= 32) and 23.5 or nil
        local st = createScaledFrameInstance(parentHost, fd, avatarPx or 32, zBehind, zFront, maxLim)
        st.backRoot.Position = avatarImgObj.Position
        st.backRoot.AnchorPoint = avatarImgObj.AnchorPoint
        st.root.Position = avatarImgObj.Position
        st.root.AnchorPoint = avatarImgObj.AnchorPoint
    end

    local function syncAllLiveAvatarFrames()
        for i = #S.activeAvatarHooks, 1, -1 do
            local hook = S.activeAvatarHooks[i]
            if hook.img and hook.img.Parent then
                local hasF = (getFrameRec(hook.lowUser) ~= nil)
                hook.img.ZIndex = 14
                S.attachAvatarFrame(hook.img, hook.lowUser, 32, 13)
                local stroke = hook.img:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Thickness = hasF and 0 or 1.3
                    stroke.Transparency = hasF and 1 or 0.25
                end
                if hook.safeZone and hook.safeZone.Parent then
                    hook.safeZone.Size = UDim2.fromOffset(hasF and 48 or 34, hasF and 48 or 34)
                    hook.safeZone.Position = UDim2.fromOffset(hasF and 14 or 13, hasF and 6 or 8)
                end
                local dotObj = hook.dot or (hook.safeZone and hook.safeZone:FindFirstChild("OnlineDot")) or hook.img:FindFirstChild("OnlineDot")
                if dotObj and dotObj.Parent then
                    if hook.safeZone and dotObj.Parent ~= hook.safeZone then
                        dotObj.Parent = hook.safeZone
                    end
                    dotObj.ZIndex = 35
                    dotObj.Position = hasF and UDim2.new(1, -4, 1, -4) or UDim2.new(1, -1, 1, -1)
                end
                if hook.cardRef and hook.cardRef.Parent then
                    local cBox = hook.cardRef:FindFirstChild("CardContentBox")
                    local cPad = hook.cardRef:FindFirstChild("CardPad")
                    local leftOff = hasF and 68 or 54
                    if cBox then
                        cBox.Position = UDim2.fromOffset(leftOff, hasF and 13 or 8)
                        cBox.Size = UDim2.new(1, -(leftOff + 10), 0, 0)
                    end
                    if cPad then
                        cPad.PaddingBottom = UDim.new(0, hasF and 14 or 9)
                    end
                    if hook.isAnyMeme and hook.cardWrapperRef then
                        local h = hasF and 164 or 152
                        hook.cardRef.Size = UDim2.new(1, 0, 0, h)
                        hook.cardWrapperRef.Size = UDim2.new(1, 0, 0, h)
                    end
                end
            else
                table.remove(S.activeAvatarHooks, i)
            end
        end
        if S.refreshFollowersLeaderboard then
            pcall(function() S.refreshFollowersLeaderboard(true) end)
        end
    end

