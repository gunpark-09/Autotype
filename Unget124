S.DELETE_LOG_FILE = "TXR_DeletedMsgs_DB_V1.json"

pcall(function()
    if S.isF(S.DELETE_LOG_FILE) then
        local rawDel = S.readF(S.DELETE_LOG_FILE)
        local decDel = rawDel and Svc.Http:JSONDecode(rawDel)
        if type(decDel) == "table" then
            if type(decDel.ids) == "table" then for k, v in pairs(decDel.ids) do if v then S.deletedMsgIds[k] = true end end end
            if type(decDel.sigs) == "table" then for k, v in pairs(decDel.sigs) do if v then S.deletedMsgSigs[k] = true end end end
        end
    end
end)

local function saveDeletedMsgsDB()
    pcall(function() S.writeF(S.DELETE_LOG_FILE, Svc.Http:JSONEncode({ ids = S.deletedMsgIds, sigs = S.deletedMsgSigs })) end)
end

local function purgeMessageFromDiskCache(targetId, targetSig)
    local changed = false
    for i = #_G.TXR_GlobalHistoryCache, 1, -1 do
        local item = _G.TXR_GlobalHistoryCache[i]
        local itemUser = tostring(item.user or ""):match("^(.-)::") or tostring(item.user or "")
        local itemSig = itemUser:lower() .. "::" .. tostring(item.msg or "")
        if (targetId and targetId ~= "" and item.key == targetId) or (targetSig and targetSig ~= "" and itemSig == targetSig) then
            table.remove(_G.TXR_GlobalHistoryCache, i); changed = true
        end
    end
    if changed then pcall(function() S.writeF(S.GLOBAL_SAVE_FILE, Svc.Http:JSONEncode(_G.TXR_GlobalHistoryCache)) end) end
end

local function applyGlobalMessageDelete(targetId, targetSig, broadcastToNet)
    if targetId and targetId ~= "" then S.deletedMsgIds[targetId] = true end
    if targetSig and targetSig ~= "" then S.deletedMsgSigs[targetSig] = true end
    saveDeletedMsgsDB(); purgeMessageFromDiskCache(targetId, targetSig)

    if targetId and S.cardWrapperById[targetId] then
        local cw = S.cardWrapperById[targetId]; S.cardWrapperById[targetId] = nil
        if cw and cw.Parent then cw:Destroy() end
    end
    if targetSig and S.cardWrapperBySig[targetSig] then
        for _, cw in ipairs(S.cardWrapperBySig[targetSig]) do if cw and cw.Parent then cw:Destroy() end end
        S.cardWrapperBySig[targetSig] = nil
    end

    if broadcastToNet then
        sendNetworkPacket({ user = lp.Name .. "::" .. lp.DisplayName, msg = string.format("__MSG_DEL__:%s|%s|%s", tostring(targetId or ""), tostring(targetSig or ""), tostring(lp.UserId)), jobId = game.JobId, hidden = true })
    end
end

