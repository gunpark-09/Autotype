local function scrollToFeedBottom()
    if not UI.messageFeed or S.chatMode == "rank" or S.chatMode == "extra" then return end
    local function jumpNow()
        if UI.messageFeed and UI.messageFeed.Parent then
            local maxOffset = math.max(0, UI.messageFeed.AbsoluteCanvasSize.Y - UI.messageFeed.AbsoluteWindowSize.Y)
            UI.messageFeed.CanvasPosition = Vector2.new(0, maxOffset)
            if UI.jumpBottomBtn then UI.jumpBottomBtn.Visible = false end
        end
    end
    jumpNow()
    task.defer(jumpNow)
    task.delay(0.06, jumpNow)
end
S.scrollToFeedBottom = scrollToFeedBottom
UI.jumpBottomBtn.MouseButton1Click:Connect(scrollToFeedBottom)

local function filterFeedMode()
    S.CURRENT_SESSION_JOB = tostring(game.JobId)
    for _, card in ipairs(UI.messageFeed:GetChildren()) do
        if card:IsA("GuiObject") and card.Name ~= "UIListLayout" and card.Name ~= "UIPadding" then
            local cardScope = card:GetAttribute("ChatScope")
            card.Visible = (cardScope == S.chatMode)
        end
    end
    updateDmHeaderLayout()
    if S.currentSearchQuery ~= "" then applySearchFilter() end
    scrollToFeedBottom()
end

local function switchChatTab(modeStr)
    S.chatMode = modeStr
    toggleMoreDrawer(false)
    local targetX = (modeStr == "server") and UDim2.new(0.00, 2, 0, 2)
        or ((modeStr == "global") and UDim2.new(0.20, 2, 0, 2)
        or ((modeStr == "dm") and UDim2.new(0.40, 2, 0, 2)
        or ((modeStr == "rank") and UDim2.new(0.60, 2, 0, 2)
        or UDim2.new(0.80, 2, 0, 2))))
    local targetBg = (modeStr == "rank") and rgb(46, 34, 12) or ((modeStr == "extra") and rgb(16, 36, 48) or Colors.ActiveTint)
    local targetBorder = (modeStr == "rank") and rgb(255, 215, 55) or ((modeStr == "extra") and rgb(0, 240, 255) or Colors.PrimaryDark)
    Svc.Tween:Create(UI.tabActiveSlider, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = targetX,
        BackgroundColor3 = targetBg
    }):Play()
    Svc.Tween:Create(UI.tabSliderStroke, TweenInfo.new(0.24), { Color = targetBorder }):Play()

    UI.serverBtn.TextColor3 = (modeStr == "server") and Colors.Primary or Colors.SubText
    UI.serverBtn.Font = (modeStr == "server") and Enum.Font.GothamBlack or Enum.Font.GothamBold

    UI.globalBtn.TextColor3 = (modeStr == "global") and Colors.Primary or Colors.SubText
    UI.globalBtn.Font = (modeStr == "global") and Enum.Font.GothamBlack or Enum.Font.GothamBold

    UI.dmTabBtn.TextColor3 = (modeStr == "dm") and Colors.Purple or Colors.SubText
    UI.dmTabBtn.Font = (modeStr == "dm") and Enum.Font.GothamBlack or Enum.Font.GothamBold

    UI.rankTabBtn.TextColor3 = (modeStr == "rank") and rgb(255, 215, 55) or Colors.SubText
    UI.rankTabBtn.Font = (modeStr == "rank") and Enum.Font.GothamBlack or Enum.Font.GothamBold

    UI.extraTabBtn.TextColor3 = (modeStr == "extra") and rgb(0, 240, 255) or Colors.SubText
    UI.extraTabBtn.Font = (modeStr == "extra") and Enum.Font.GothamBlack or Enum.Font.GothamBold

    if modeStr == "dm" then
        S.unreadDmCount = 0
        UI.dmUnreadPill.Visible = false
    elseif modeStr == "rank" and S.refreshFollowersLeaderboard then
        S.refreshFollowersLeaderboard(true)
    end

    filterFeedMode()
end
