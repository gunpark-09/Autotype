local function modifyUserFollowersDelta(targetUser, deltaNum)
    if not isVerifiedOwner(lp.Name:lower(), lp.UserId) then return end
    local delta = math.floor(tonumber(deltaNum) or 0)
    if delta == 0 then return end

    local tUser = targetUser or S.boostTargetUser or lp.Name
    local tLow = tUser:lower()
    if tLow == "system" then return end

    S.knownUsers[tLow] = tUser
    S.socialGraph.followers[tLow] = S.socialGraph.followers[tLow] or {}

    local curTotal = getFollowerCountForUser(tLow)
    local newTotal = curTotal + delta

    if delta > 0 then
        ensureRealFollowersPopulated(tLow, newTotal)
    else
        local toRemove = math.abs(delta)
        local removed = 0
        for fLow, active in pairs(S.socialGraph.followers[tLow]) do
            if active and removed < toRemove then
                S.socialGraph.followers[tLow][fLow] = nil
                if S.socialGraph.following[fLow] then
                    S.socialGraph.following[fLow][tLow] = nil
                end
                removed += 1
            end
        end
        if newTotal <= 0 then
            S.socialGraph.followers[tLow] = {}
        end
    end

    S.socialGraph.knownCountCache[tLow] = newTotal
    animateFollowerRollout(tLow, curTotal, newTotal)
    saveProfilePrefs()

    if tLow == lp.Name:lower() then
        broadcastMyProfileStyle()
    end
    broadcastTargetFollowerOverride(tUser, newTotal)

    if S.triggerBoostSuccessFx then S.triggerBoostSuccessFx(tLow, delta, newTotal) end
    if S.refreshFollowersLeaderboard then S.refreshFollowersLeaderboard(true) end
    if S.refreshProfileSocialUI then S.refreshProfileSocialUI() end
    if S.refreshTagPermissions then S.refreshTagPermissions() end
    if S.updateBoostHeaderStat then S.updateBoostHeaderStat() end
end
