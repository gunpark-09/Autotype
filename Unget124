S.refreshTagPermissions = function()
    local myLow = lp.Name:lower()
    local isOwner = isVerifiedOwner(myLow, lp.UserId)
    local rankTagKey = getRankExclusiveTagKey(myLow)
    local unlocked = isOwner or (rankTagKey ~= nil)

    UI.liveTagsDrawerBtn.Visible = unlocked

    if isOwner then
        UI.liveTagsDrawerBtn.Text = "  " .. sc("🏷️  LIVE TAGS (OWNER)")
        UI.liveTagsDrawerBtn.TextColor3 = Colors.Primary
        if UI.badgeHeaderLbl then
            UI.badgeHeaderLbl.Text = sc("OWNER TAG STUDIO (ALL TAGS)")
            UI.badgeHeaderLbl.TextColor3 = Colors.Primary
        end
    elseif rankTagKey then
        local rNum = getGlobalFollowerRankForUser(myLow) or 1
        UI.liveTagsDrawerBtn.Text = "  " .. sc("🏷️  RANK #" .. tostring(rNum) .. " TAG")
        UI.liveTagsDrawerBtn.TextColor3 = rgb(255, 215, 55)
        if S.currentOwnerBadge ~= "NONE" and S.currentOwnerBadge ~= rankTagKey then
            S.currentOwnerBadge = rankTagKey
            S.userCustomBadges[myLow] = rankTagKey
            saveProfilePrefs()
            broadcastMyProfileStyle()
        end
        if UI.badgeHeaderLbl then
            UI.badgeHeaderLbl.Text = sc("YOUR RANK #" .. tostring(rNum) .. " EXCLUSIVE TAG")
            UI.badgeHeaderLbl.TextColor3 = rgb(255, 215, 55)
        end
    else
        if S.currentOwnerBadge ~= "NONE" then
            S.currentOwnerBadge = "NONE"
            S.userCustomBadges[myLow] = "NONE"
            saveProfilePrefs()
            broadcastMyProfileStyle()
        end
        if S.isBadgeModalOpen and UI.badgeSelectorModal then
            S.isBadgeModalOpen = false
            UI.badgeSelectorModal:FindFirstChildOfClass("UIScale").Scale = 0
            UI.badgeSelectorModal.Visible = false
        end
    end

    if S.isBadgeModalOpen and S.rebuildBadgeModalItems then
        S.rebuildBadgeModalItems()
    end

    UI.addFollowersDrawerBtn.Visible = isOwner
    UI.muteControlDrawerBtn.Visible = isOwner

    local rowCount = 2 + (unlocked and 1 or 0) + (isOwner and 2 or 0)
    UI.moreDrawer.Size = UDim2.fromOffset(176, 10 + (rowCount * 32))
end

