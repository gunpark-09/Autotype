        addMessageToFeed(encodedUserTag, payloadBodyText, S.privateTarget, true, game.JobId, "dm", nil, genMsgId)
    else
        addMessageToFeed(encodedUserTag, payloadBodyText, nil, false, game.JobId, currentScope, nil, genMsgId)
        if currentScope == "global" then
            saveGlobalMessageToDisk(encodedUserTag, payloadBodyText, genMsgId)
        end
    end
    displayBubble(lp.Name, text)

    if text:lower():match("^[@/]ai") then
        handleSmartAIQuery(text)
    end

    local localEchoSig = encodedUserTag .. "::" .. finalMsg
    S.recentLocalSentMap[localEchoSig] = (S.recentLocalSentMap[localEchoSig] or 0) + 1

    task.spawn(function()
        if S.req then
            local payload = Svc.Http:JSONEncode({ user = encodedUserTag, msg = finalMsg, jobId = game.JobId })
            pcall(function()
                S.req({
                    Url = S.SERVER_URL .. "/send", Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = payload
                })
            end)
        end
    end)
end

