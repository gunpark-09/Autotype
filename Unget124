-- Centralized Layout & Tab View Router (Prevents any DM/Rank/Server view overlap)
local function syncActiveTabLayout()
    local mode = S.chatMode

    -- 1. Hide all secondary/overlay views first
    if UI.rankingArenaView then UI.rankingArenaView.Visible = false end
    if UI.extraArenaView then UI.extraArenaView.Visible = false end
    if UI.dmInboxView then UI.dmInboxView.Visible = false end
    if UI.dmHeaderBar then UI.dmHeaderBar.Visible = false end
    if UI.dmNewPickerModal then UI.dmNewPickerModal.Visible = false end
    if UI.actionMenu then UI.actionMenu.Visible = false end
    if UI.autoCompleteBar then UI.autoCompleteBar.Visible = false end
    if UI.liveTypingPill then UI.liveTypingPill.Visible = false end

    -- 2. Apply exact layout for active mode
    if mode == "rank" then
        UI.messageFeed.Visible = false
        if UI.jumpBottomBtn then UI.jumpBottomBtn.Visible = false end
        if UI.inputContainer then UI.inputContainer.Visible = false end
        if UI.replyBanner then UI.replyBanner.Visible = false end
        if UI.rankingArenaView then UI.rankingArenaView.Visible = true end
        return
    elseif mode == "extra" then
        UI.messageFeed.Visible = false
        if UI.jumpBottomBtn then UI.jumpBottomBtn.Visible = false end
        if UI.inputContainer then UI.inputContainer.Visible = false end
        if UI.replyBanner then UI.replyBanner.Visible = false end
        if UI.extraArenaView then UI.extraArenaView.Visible = true end
        return
    elseif mode == "dm" then
        if UI.dmHeaderBar then UI.dmHeaderBar.Visible = true end
        if S.activeDmChatUser then
            -- Inside 1-on-1 DM Room
            if UI.dmInboxView then UI.dmInboxView.Visible = false end
            UI.messageFeed.Visible = true
            if UI.inputContainer then UI.inputContainer.Visible = true end
            UI.messageFeed.Position = UDim2.new(0, 12, 0, 126)
            UI.messageFeed.Size = UDim2.new(1, -24, 1, S.activeReplyData and -220 or -188)
        else
            -- WhatsApp DM Inbox List
            UI.messageFeed.Visible = false
            if UI.jumpBottomBtn then UI.jumpBottomBtn.Visible = false end
            if UI.inputContainer then UI.inputContainer.Visible = false end
            if UI.replyBanner then UI.replyBanner.Visible = false end
            if UI.dmInboxView then UI.dmInboxView.Visible = true end
        end
        if S.onDmLayoutSync then S.onDmLayoutSync() end
    else
        -- SERVER or GLOBAL Chat Feed
        S.privateTarget = nil
        if S.updateInputBar then S.updateInputBar(true) end
        UI.messageFeed.Visible = true
        if UI.inputContainer then UI.inputContainer.Visible = true end
        UI.messageFeed.Position = UDim2.new(0, 12, 0, 90)
        UI.messageFeed.Size = UDim2.new(1, -24, 1, S.activeReplyData and -184 or -152)
        if S.updateMuteLockUI then S.updateMuteLockUI() end
    end

    -- 3. Filter message cards strictly to active scope
    for _, card in ipairs(UI.messageFeed:GetChildren()) do
        if card:IsA("GuiObject") and card.Name ~= "UIListLayout" and card.Name ~= "UIPadding" then
            card.Visible = (card:GetAttribute("ChatScope") == mode)
        end
    end
    if S.currentSearchQuery ~= "" then applySearchFilter() end
    scrollToFeedBottom()
end
S.syncActiveTabLayout = syncActiveTabLayout

