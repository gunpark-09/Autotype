                table.remove(S.activeFxList, i)
            else
                local fx, s = f.fx, f.seed
                if fx == "wobble" then
                    f.host.Rotation = math.sin(t * 5 + s) * 4.5
                    f.scale.Scale = 1 + math.sin(t * 3 + s) * 0.03
                elseif fx == "pulse" then
                    f.scale.Scale = 1 + (math.sin(t * 4 + s) + 1) * 0.035
                elseif fx == "heartbeat" then
                    local b = math.max(0, math.sin(t * 6.5 + s))
                    f.scale.Scale = 1 + (b ^ 3) * 0.14
                elseif fx == "float" then
                    f.host.Rotation = math.sin(t * 2.2 + s) * 2.2
                    f.scale.Scale = 1 + math.sin(t * 2.2 + s) * 0.025
                elseif fx == "shake" then
                    local ph = (t + s) % 3
                    if ph < 0.55 then f.host.Rotation = math.sin(t * 38) * 3.2 else f.host.Rotation = 0 end
                elseif fx == "flash" then
                    if f.stroke then f.stroke.Transparency = 0.05 + math.abs(math.sin(t * 5 + s)) * 0.65 end
                    f.scale.Scale = 1 + (math.sin(t * 3 + s) + 1) * 0.02
                elseif fx == "glitch" then
                    local ph = (t * 0.9 + s) % 2.6
                    if ph < 0.26 then
                        f.host.Rotation = (math.random() - 0.5) * 4
                        if f.gR then f.gR.Position = UDim2.fromOffset(math.random(-3, 0), math.random(-1, 1)) end
