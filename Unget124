                    end)
                end
                local cardPos = cardWrapper.AbsolutePosition - UI.mainFrame.AbsolutePosition
                UI.actionMenu.Position = UDim2.fromOffset(math.clamp(cardPos.X + 25, 10, 180), math.clamp(cardPos.Y - 24, 30, 280))
                UI.actionMenu.Visible = true
            end
        end
    end)

    cardWrapper.Destroying:Connect(function()
        if moveConn then moveConn:Disconnect() end
        if endConn then endConn:Disconnect() end
    end)

    if cardWrapper.Visible then
        task.defer(function()
