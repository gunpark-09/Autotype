local function crispText(element, overrideTransparency)
    pcall(function()
        local stroke = element:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", element)
        stroke.Color = Color3.new(0, 0, 0)
        stroke.Transparency = overrideTransparency or 0.40
        stroke.Thickness = 1.0
    end)
end

local function applySpringHover(btn)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    local origTrans = btn.BackgroundTransparency
    local hoverTrans = math.max(0, origTrans - 0.15)
    btn.MouseEnter:Connect(function()
        Svc.Tween:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.05}):Play()
        Svc.Tween:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {BackgroundTransparency = hoverTrans}):Play()
    end)
    btn.MouseLeave:Connect(function()
        Svc.Tween:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
        Svc.Tween:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {BackgroundTransparency = origTrans}):Play()
    end)
    btn.MouseButton1Down:Connect(function() Svc.Tween:Create(btnScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), {Scale = 0.94}):Play() end)
    btn.MouseButton1Up:Connect(function() Svc.Tween:Create(btnScale, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1.05}):Play() end)
end

local function playSFX(soundType)
    task.spawn(function()
        pcall(function()
            local s = Instance.new("Sound")
            if soundType == "mention" or soundType == "broadcast" or soundType == "dm" then s.SoundId = "rbxassetid://9114223177"; s.Volume = 0.80
            elseif soundType == "meme" then s.SoundId = "rbxassetid://9069609268"; s.Volume = 0.55
            elseif soundType == "reaction" then s.SoundId = "rbxassetid://6895079853"; s.Volume = 0.50
            else s.SoundId = "rbxassetid://6518811702"; s.Volume = 0.35 end
            s.Parent = Svc.Sound; s:Play()
            task.delay(1.5, function() pcall(function() s:Destroy() end) end)
        end)
    end)
end

_G.TXR_GlobalHistoryCache = _G.TXR_GlobalHistoryCache or {}
pcall(function()
    if #_G.TXR_GlobalHistoryCache == 0 and S.isF(S.GLOBAL_SAVE_FILE) then
        local raw = S.readF(S.GLOBAL_SAVE_FILE)
        if raw then
            local decoded = Svc.Http:JSONDecode(raw)
            if type(decoded) == "table" then _G.TXR_GlobalHistoryCache = decoded end
        end
    end
end)

local function saveGlobalMessageToDisk(userTag, cleanMsg, msgIdKey)
    for _, item in ipairs(_G.TXR_GlobalHistoryCache) do
        if item.key == msgIdKey then return end
    end
    table.insert(_G.TXR_GlobalHistoryCache, { user = userTag, msg = cleanMsg, key = msgIdKey, t = os.date("%H:%M") })
    while #_G.TXR_GlobalHistoryCache > 200 do table.remove(_G.TXR_GlobalHistoryCache, 1) end
    pcall(function() S.writeF(S.GLOBAL_SAVE_FILE, Svc.Http:JSONEncode(_G.TXR_GlobalHistoryCache)) end)
end

local function isInternalAlienPacket(msgStr)
    if not msgStr then return true end
    return msgStr:sub(1, 5) == "[EMP_"
end

local function displayBubble(userName, msg)
    if S.mutedUsers[userName:lower()] then return end
    local speaker = findPlayerCI(userName)
    if not speaker or not speaker.Character then return end
    local cleanMsg = (msg:find("%[MEME:") or msg:find("%[WEBMEME:")) and "[Meme Sticker]" or msg
    pcall(function()
        if Svc.TextChat.ChatVersion == Enum.ChatVersion.TextChatService then
            Svc.TextChat:DisplayBubble(speaker.Character, cleanMsg)
        else
            local head = speaker.Character:FindFirstChild("Head")
            if head then Svc.Chat:Chat(head, cleanMsg, Enum.ChatColor.White) end
        end
    end)
end

