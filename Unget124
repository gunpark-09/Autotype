                tile.MouseEnter:Connect(function() Svc.Tween:Create(tileScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.05 }):Play(); Svc.Tween:Create(tStroke, TweenInfo.new(0.16), { Color = Colors.Primary, Transparency = 0 }):Play() end)
