local function applySearchFilter()
    if not UI.messageFeed then return end
    local q = S.currentSearchQuery:lower()
    for _, cardWrap in ipairs(UI.messageFeed:GetChildren()) do
        if cardWrap:IsA("GuiObject") and cardWrap.Name ~= "UIListLayout" and cardWrap.Name ~= "UIPadding" then
            local cardScope = cardWrap:GetAttribute("ChatScope")
            local tabMatch = (cardScope == S.chatMode)
            if not tabMatch then
                cardWrap.Visible = false
            elseif q == "" then
                cardWrap.Visible = true
            else
                local blob = tostring(cardWrap:GetAttribute("SearchBlob") or ""):lower()
                cardWrap.Visible = blob:find(q, 1, true) ~= nil
            end
        end
    end
end

