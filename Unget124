    local function renderProfileMediaPage()
        for _, c in ipairs(pmsGrid:GetChildren()) do if c:IsA("ImageButton") then c:Destroy() end end
        local totalItems = #S.profMediaItems
        local totalPages = math.max(1, math.ceil(totalItems / 9))
        S.profMediaPageIdx = math.clamp(S.profMediaPageIdx, 1, totalPages)
        pmsPageLbl.Text = string.format("%s %d / %d  •  %d", sc("PAGE"), S.profMediaPageIdx, totalPages, totalItems)
        pmsPrevBtn.TextTransparency = (S.profMediaPageIdx > 1) and 0 or 0.55

        for i = (S.profMediaPageIdx - 1) * 9 + 1, math.min(totalItems, S.profMediaPageIdx * 9) do
            local cleanUrl = S.profMediaItems[i]
            if cleanUrl then
                local tile = mk("ImageButton", pmsGrid, { BackgroundColor3 = rgb(16, 21, 33), Image = "", ScaleType = Enum.ScaleType.Crop, AutoButtonColor = false, ClipsDescendants = true, ZIndex = 347, Corner = UDim.new(0, 9) })
