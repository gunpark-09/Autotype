    profBlockBtn.MouseButton1Click:Connect(function()
        if not S.activeProfileUser then return end
        local pLow = S.activeProfileUser:lower()
        local nextBlk = not (S.blockedDmUsers[pLow] == true)
        if nextBlk then S.blockedDmUsers[pLow] = true else S.blockedDmUsers[pLow] = nil end
        saveDmDatabase()
        broadcastDmBlockPacket(S.activeProfileUser, nextBlk)
        syncProfileBlockBtn()
        refreshDmHeaderControls()
        getTotalUnreadDms()
        playSFX(nextBlk and "default" or "reaction")
    end)

    local prevOpenProfile = S.openProfile
    S.openProfile = function(username, dispName, uId, isAdmin, isAI)
        prevOpenProfile(username, dispName, uId, isAdmin, isAI)
        syncProfileBlockBtn()
        for _, ch in ipairs(UI.profileModal:GetDescendants()) do
            if ch:IsA("TextButton") and ch.Position == UDim2.new(1, -14, 0, 99) then
                ch.Position = (username:lower() ~= myLow and not isAI) and UDim2.new(1, -92, 0, 99) or UDim2.new(1, -14, 0, 99)
            end
        end
    end

    local function recordMessageInConversation(partnerUser, partnerDisp, senderUser, bodyText, msgId, timeStr, isIncomingUnread)
        local conv = ensureConversationRecord(partnerUser, partnerDisp)
        if not conv then return end

        for _, existing in ipairs(conv.messages) do
            if existing.id == msgId then return end
        end

        table.insert(conv.messages, {
            id = msgId,
            sender = senderUser,
            msg = bodyText,
            timeStr = timeStr or os.date("%H:%M")
        })
        conv.lastTime = os.time()
        conv.lastTimeStr = timeStr or os.date("%H:%M")
        conv.lastMsg = (tostring(senderUser):lower() == myLow and "You: " or "") .. bodyText

        if isIncomingUnread then
            local viewingThisRoom = (S.chatMode == "dm" and S.activeDmChatUser and S.activeDmChatUser:lower() == partnerUser:lower() and UI.mainFrame.Visible)
            if not viewingThisRoom then
                conv.unread = (tonumber(conv.unread) or 0) + 1
            end
        end

        saveDmDatabase()
        getTotalUnreadDms()
        if S.chatMode == "dm" and not S.activeDmChatUser then
            renderDmInboxList()
        end
    end

    S.onBeforeSendDm = function(targetUser, cleanBody)
        local tLow = targetUser:lower()
        if S.blockedDmUsers[tLow] then
            UI.chatInput.Text = ""
            addMessageToFeed("System::" .. BRAND_TITLE, "🚫 You blocked @" .. targetUser .. ". Tap UNBLOCK in the top bar to send messages.", targetUser, false, game.JobId, "dm")
            return false
        end
        if S.blockedByUsers[tLow] then
            UI.chatInput.Text = ""
            addMessageToFeed("System::" .. BRAND_TITLE, "🚫 Message not delivered — @" .. targetUser .. " has blocked you from sending DMs.", targetUser, false, game.JobId, "dm")
            return false
        end
        local msgId = lp.Name .. "_DM_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
        recordMessageInConversation(targetUser, S.knownDispNames[tLow] or targetUser, lp.Name, cleanBody, msgId, os.date("%H:%M"), false)
        if not S.activeDmChatUser or S.activeDmChatUser:lower() ~= tLow then
            openDmConversationRoom(targetUser, S.knownDispNames[tLow] or targetUser)
        end
        return true
    end

    -- Export DM packet handler to Central Network Router (Handles Private DMs & Blocks cleanly!)
    S.onDmEnginePacket = function(m, wasInitial)
        if type(m) ~= "table" or type(m.msg) ~= "string" or type(m.user) ~= "string" then return false end
        local rawU, rawD = m.user:match("^(.-)::(.*)$")
        local senderU = rawU or m.user
        local senderD = rawD or senderU
        local senderLow = senderU:lower()

        local blkTgt, blkState = m.msg:match("^__DM_BLOCK__:([^|]+)|([01])$")
        if blkTgt then
            if blkTgt:lower() == myLow then
                if blkState == "1" then
                    S.blockedByUsers[senderLow] = true
                else
                    S.blockedByUsers[senderLow] = nil
                end
                saveDmDatabase()
                refreshDmHeaderControls()
            end
            return true
        end

        local effectiveMsg = m.msg:gsub("^%[SRV:.-%]%s*", ""):gsub("^%[GLB%]%s*", "")
        local pSender, pTarget, rawPmBody = string.match(effectiveMsg, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
        if pSender and pTarget then
            local uidKey = tostring(m.id or (tostring(m.time) .. "_" .. m.user .. "_" .. m.msg))
            local nidTag, cleanPmBody = rawPmBody:match("^%[NID:([^%]]+)%]%s*(.*)$")
            if not cleanPmBody then cleanPmBody = rawPmBody end

            if nidTag and S.localSentNonces[nidTag] then
                return true
            end
            if seenDmNetIds[uidKey] then return true end
            seenDmNetIds[uidKey] = true

            if pTarget:lower() == myLow then
                if S.blockedDmUsers[pSender:lower()] then
                    return true
                end
                recordMessageInConversation(pSender, senderD, pSender, cleanPmBody, uidKey, os.date("%H:%M"), not wasInitial)
                local viewingThisRoom = (S.chatMode == "dm" and S.activeDmChatUser and S.activeDmChatUser:lower() == pSender:lower())
                if viewingThisRoom then
                    addMessageToFeed(m.user, cleanPmBody, pSender, false, m.jobId, "dm", nil, uidKey)
                    scrollToFeedBottom()
                end
                if not wasInitial then
                    local _, _, strippedBubble = cleanPmBody:match("^%[REP:([^|]+)|([^%]]+)%]%s*(.*)$")
                    displayBubble(senderU, strippedBubble or cleanPmBody)
                    playSFX("dm")
                    if not UI.mainFrame.Visible then
                        S.unreadCount = S.unreadCount + 1
                        UI.unreadTxt.Text = tostring(S.unreadCount)
                        UI.unreadBadge.Visible = true
                        triggerOrbToast(sc("DM") .. " • " .. senderD, strippedBubble or cleanPmBody)
                    end
                end
            elseif pSender:lower() == myLow then
                recordMessageInConversation(pTarget, S.knownDispNames[pTarget:lower()] or pTarget, lp.Name, cleanPmBody, uidKey, os.date("%H:%M"), false)
                local viewingThisRoom = (S.chatMode == "dm" and S.activeDmChatUser and S.activeDmChatUser:lower() == pTarget:lower())
                if viewingThisRoom and wasInitial then
                    addMessageToFeed(m.user, cleanPmBody, pTarget, true, m.jobId, "dm", nil, uidKey)
                end
            end
            return true
        end
        return false
    end

    getTotalUnreadDms()
end


-- =========================================================
-- 🌐 ENGINE 3: CENTRALIZED SINGLE-DECODE NETWORK POLLING ROUTER (ZERO DOUBLE ECHO / ZERO LOOP OVERHEAD)
-- =========================================================
task.spawn(function()
    while _G.TXR_IsPolling and (_G.TXR_ChatInstanceID == currentExecutionID) and UI.gui and UI.gui.Parent do
        if S.req then
            local querySince = S.isInitialSync and 0 or math.max(0, math.floor(S.lastSyncTime) - 2)
            local success, res = pcall(function()
                return S.req({
                    Url = S.SERVER_URL .. "/messages?since=" .. tostring(querySince),
                    Method = "GET", Headers = { ["User-Agent"] = "Roblox/WinInet" }
                })
            end)

            if success and res and (res.StatusCode == 200 or res.Status == 200) then
                local decodeSuccess, data = pcall(function() return Svc.Http:JSONDecode(res.Body) end)

                if decodeSuccess and type(data) == "table" then
                    local wasInitial = S.isInitialSync
                    S.isInitialSync = false

                    for idx, m in ipairs(data) do
                        if m and m.msg and m.user then
                            local mTime = tonumber(m.time) or 0
                            if mTime > S.lastSyncTime then S.lastSyncTime = mTime end

                            if checkAndTriggerDynamicIslandPacket(m.msg, m.user, wasInitial) then
                                continue
                            end
                            if isInternalAlienPacket(m.msg) then
                                continue
                            end

                            -- 1) Dispatch to Tag & Cosmetic Engine
                            if S.onTagEnginePacket and S.onTagEnginePacket(m, wasInitial) then
                                continue
                            end

                            -- 2) Dispatch to WhatsApp DM & Block Engine
                            if S.onDmEnginePacket and S.onDmEnginePacket(m, wasInitial) then
                                continue
                            end

                            local rawU, rawD = m.user:match("^(.-)::(.*)$")
                            local rawUsernameOnly = rawU or m.user
                            local rawDispOnly = rawD or rawUsernameOnly
                            local actorLow = rawUsernameOnly:lower()
                            local packetJob = tostring(m.jobId or "")

                            if not wasInitial then
                                updateLiveCounter(rawUsernameOnly, rawDispOnly, packetJob)
                            end

                            local muteTgt, muteSt, muteSenderUid = m.msg:match("^__MUTE_SET__:([^|]+)|([01])|?(.*)$")
                            if muteTgt and verifySenderOwnership(actorLow, muteSenderUid) then
                                local sysKey = "SYS_" .. tostring(m.id or idx) .. "_" .. tostring(mTime) .. "_" .. m.msg
                                if not RenderedCardKeys[sysKey] then
                                    RenderedCardKeys[sysKey] = true
                                    local isNowMuted = (muteSt == "1")
                                    setGlobalMuteState(muteTgt, isNowMuted, false)
                                    if not wasInitial and muteTgt:lower() == lp.Name:lower() then
                                        addMessageToFeed("System::" .. BRAND_TITLE, isNowMuted and "🔇 You have been MUTED by the Owner." or "🔊 You have been UNMUTED by the Owner.", nil, false, game.JobId, S.chatMode)
                                    end
                                end
                                continue
                            end

                            local delId, delSig, delUid = m.msg:match("^__MSG_DEL__:([^|]*)|([^|]*)|?(.*)$")
                            if delId ~= nil or delSig ~= nil then
                                local sigOwner = delSig and delSig:match("^([^:]+)::") or ""
                                if actorLow == sigOwner or verifySenderOwnership(actorLow, delUid) then
                                    applyGlobalMessageDelete(delId, delSig, false)
                                end
                                continue
                            end

                            local pThemeIdx, pMoodStr, pAvVal, pBanVal, pBioStr = m.msg:match("^__PROF_STYLE__:(%d+)|([^|]*)|([^|]*)|([^|]*)|(.*)$")
                            if pThemeIdx then
                                S.userProfiles[actorLow] = {
                                    themeIdx = tonumber(pThemeIdx) or 1,
                                    mood = (pMoodStr ~= "" and pMoodStr) or ("⚡ " .. sc("ACTIVE")),
                                    customAv = pAvVal or "",
                                    customBan = pBanVal or "",
                                    bio = (pBioStr ~= "" and pBioStr) or "TXR ReChat Network Member."
                                }
                                refreshUserAvatarsInFeed(actorLow)
                                continue
                            end

                            local tagKeyStr, tagSenderUid = m.msg:match("^__TAG_SET__:([^|]+)|?(.*)$")
                            if tagKeyStr then
                                if tagKeyStr == "NONE" or verifySenderOwnership(actorLow, tagSenderUid) or RankExclusiveTagKeys[getGlobalFollowerRankForUser(actorLow) or 0] == tagKeyStr then
                                    S.userCustomBadges[actorLow] = tagKeyStr
                                end
                                continue
                            end

                            local folCntStr, folUidStr = m.msg:match("^__FOL_RANK__:(-?%d+)|(.*)$")
                            if folCntStr then
                                local cntNum = tonumber(folCntStr) or 0
                                local uidNum = tonumber(folUidStr)
                                if uidNum then
                                    S.userIdCache[actorLow] = uidNum
                                    if uidNum == S.MY_VIP_ID then verifySenderOwnership(actorLow, folUidStr) end
                                end
                                if actorLow ~= lp.Name:lower() or S.socialGraph.knownCountCache[actorLow] == nil then
                                    S.socialGraph.knownCountCache[actorLow] = cntNum
                                    S.visualFollowerDisplay[actorLow] = cntNum
                                    ensureRealFollowersPopulated(actorLow, cntNum)
                                end
                                continue
                            end

                            local setTgt, setValStr, setUidStr, setSenderUid = m.msg:match("^__FOL_SET__:([^|]+)|(-?%d+)|([^|]*)|?(.*)$")
                            if setTgt and verifySenderOwnership(actorLow, setSenderUid) then
                                local tLow = setTgt:lower()
                                local nVal = tonumber(setValStr) or 0
                                local uVal = tonumber(setUidStr)
                                if uVal and uVal > 0 then S.userIdCache[tLow] = uVal end
                                S.socialGraph.knownCountCache[tLow] = nVal
                                S.visualFollowerDisplay[tLow] = nVal
                                ensureRealFollowersPopulated(tLow, nVal)
                                continue
                            end

                            local syncTgt, syncTgtCnt, syncActCnt = m.msg:match("^__FOL_SYNC__:([^|]+)|(-?%d+)|(-?%d+)$")
                            if syncTgt then
                                local tLow = syncTgt:lower()
                                local tC = tonumber(syncTgtCnt) or 0
                                local aC = tonumber(syncActCnt) or 0
                                if tLow ~= lp.Name:lower() or S.socialGraph.knownCountCache[tLow] == nil then
                                    S.socialGraph.knownCountCache[tLow] = tC
                                    S.visualFollowerDisplay[tLow] = tC
                                    ensureRealFollowersPopulated(tLow, tC)
                                end
                                if actorLow ~= lp.Name:lower() or S.socialGraph.knownCountCache[actorLow] == nil then
                                    S.socialGraph.knownCountCache[actorLow] = aC
                                    S.visualFollowerDisplay[actorLow] = aC
                                    ensureRealFollowersPopulated(actorLow, aC)
                                end
                                continue
                            end

                            local fTarget, fState = m.msg:match("^__FOLLOW__:([^|]+)|([01])$")
                            if fTarget then
                                applyFollowRelation(actorLow, fTarget:lower(), fState == "1")
                                continue
                            end

                            if m.msg:find("^__LIKE__:") then continue end

                            local rTargetId, rEmoji = m.msg:match("^__REACT__:([^|]+)|(.*)$")
                            if rTargetId and rEmoji then
                                if S.cardReactionHooks[rTargetId] then S.cardReactionHooks[rTargetId](rEmoji, false) end
                                continue
                            end

                            local urTargetId, urEmoji = m.msg:match("^__UNREACT__:([^|]+)|(.*)$")
                            if urTargetId and urEmoji then
                                if S.cardReactionHooks[urTargetId] then S.cardReactionHooks[urTargetId](urEmoji, true) end
                                continue
                            end

                            if m.msg == "__TYPING__" then
                                if not wasInitial and actorLow ~= lp.Name:lower() and packetJob == tostring(game.JobId) then
                                    S.remoteTypers[rawDispOnly] = tick() + 3.2
                                end
                                continue
                            end

                            local joinNonce = m.msg:match("^Joined:?([%w_]*)$")
                            if joinNonce ~= nil or m.msg == "__REQ_SYNC__" then
                                if not wasInitial then
                                    local stableJoinKey = "JOIN_" .. actorLow .. "_" .. tostring(m.id or mTime) .. "_" .. tostring(joinNonce or "")
                                    if not RenderedCardKeys[stableJoinKey] then
                                        RenderedCardKeys[stableJoinKey] = true
                                        if joinNonce ~= nil and actorLow ~= lp.Name:lower() and packetJob == tostring(game.JobId) then
                                            if not SessionJoinShown[actorLow] then
                                                SessionJoinShown[actorLow] = true
                                                addJoinNotice(rawDispOnly, "server", sc("joined the server"))
                                                playSFX("default")
                                            end
                                        end
                                        if actorLow ~= lp.Name:lower() then
                                            task.delay(math.random(1, 8) * 0.1, function()
                                                broadcastMyProfileStyle()
                                            end)
                                        end
                                    end
                                end
                                continue
                            end

                            if m.hidden then continue end

                            local srvJob, cleanSrvMsg = m.msg:match("^%[SRV:(.-)%]%s*(.*)$")
                            local cleanGlbMsg = m.msg:match("^%[GLB%]%s*(.*)$")
                            local scope, effectiveMsg = "global", m.msg

                            if srvJob then
                                scope, effectiveMsg = "server", cleanSrvMsg
                                if tostring(srvJob) ~= tostring(game.JobId) then continue end
                            elseif cleanGlbMsg then
                                scope, effectiveMsg = "global", cleanGlbMsg
                            end

                            -- Extract & strip Client Nonce [NID:...] so our own sent Global/Server message NEVER renders twice
                            local msgNonce, strippedMsg = effectiveMsg:match("^%[NID:([^%]]+)%]%s*(.*)$")
                            if msgNonce then
                                effectiveMsg = strippedMsg
                                if S.localSentNonces[msgNonce] then
                                    continue
                                end
                            end

                            local uniqueMsgKey = (m.id and tostring(m.id)) or (tostring(mTime) .. "_" .. tostring(m.user) .. "_" .. tostring(effectiveMsg))
                            if RenderedCardKeys[uniqueMsgKey] then continue end
                            RenderedCardKeys[uniqueMsgKey] = true

                            S.remoteTypers[rawDispOnly] = nil

                            if actorLow == lp.Name:lower() then
                                local localEchoSig = tostring(m.user) .. "::" .. tostring(m.msg)
                                local pendingCount = S.recentLocalSentMap[localEchoSig] or 0
                                if pendingCount > 0 then
                                    S.recentLocalSentMap[localEchoSig] = (pendingCount > 1) and (pendingCount - 1) or nil
                                    continue
                                end
                                if msgNonce then
                                    continue
                                end
                            end

                            addMessageToFeed(m.user, effectiveMsg, nil, false, m.jobId, scope, nil, uniqueMsgKey)
                            if scope == "global" then saveGlobalMessageToDisk(m.user, effectiveMsg, uniqueMsgKey) end

                            if not wasInitial and rawUsernameOnly ~= lp.Name then
                                local _, _, strippedBubble = effectiveMsg:match("^%[REP:([^|]+)|([^%]]+)%]%s*(.*)$")
                                displayBubble(rawUsernameOnly, strippedBubble or effectiveMsg); playSFX("default")
                                if not UI.mainFrame.Visible then
                                    S.unreadCount = S.unreadCount + 1; UI.unreadTxt.Text = tostring(S.unreadCount); UI.unreadBadge.Visible = true
                                    triggerOrbToast(rawDispOnly, strippedBubble or effectiveMsg)
                                end
                            end
                        end
                    end

                    if wasInitial then
                        saveGlobalProfilesDB()
                        if S.refreshFollowersLeaderboard then S.refreshFollowersLeaderboard() end
                        if S.refreshTagPermissions then S.refreshTagPermissions() end
                        if S.refreshCurrentOpenProfile then S.refreshCurrentOpenProfile() end
                        scrollToFeedBottom()
                    end
                end
            end
        end
        task.wait(0.45)
    end
end)

