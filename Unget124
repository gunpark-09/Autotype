    local function rebuildTargetChips()
        for _, c in ipairs(chipsScroll:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local seen, list = {}, {}
        local function push(uName, dName)
            if not uName or uName == "" or uName:lower() == "system" then return end
            local low = uName:lower()
            if not seen[low] and #list < 40 then
                seen[low] = true
                table.insert(list, { user = uName, disp = dName or uName })
            end
        end
        push(lp.Name, sc("ME") .. " (" .. lp.DisplayName .. ")")
        for _, plr in ipairs(Svc.Players:GetPlayers()) do
            if plr ~= lp then push(plr.Name, plr.DisplayName) end
        end
        for uLow, info in pairs(S.activeUsersTable) do
            local rU = (type(info) == "table" and info.user) or S.knownUsers[uLow] or uLow
            local rD = (type(info) == "table" and info.disp) or S.knownDispNames[uLow] or rU
            push(rU, rD)
        end
        for uLow, rU in pairs(S.knownUsers) do push(rU, S.knownDispNames[uLow] or rU) end
        for _, item in ipairs(list) do
            local isSel = ((engineTarget or ""):lower() == item.user:lower())
            local chip = mk("TextButton", chipsScroll, {
                AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 22),
                BackgroundColor3 = isSel and rgb(46, 36, 14) or rgb(18, 24, 36), Text = "  " .. item.disp .. "  ",
                TextColor3 = isSel and GOLD or Colors.Text, Font = Enum.Font.GothamBlack, TextSize = 8.8,
                AutoButtonColor = false, ZIndex = 424, Corner = UDim.new(1, 0),
                Stroke = { Color = isSel and GOLD or Colors.PrimaryDark, Thickness = 0.9, Transparency = 0.3 }
            })
            applySpringHover(chip)
            chip.MouseButton1Click:Connect(function()
                engineTarget = item.user
                rebuildTargetChips()
                rebuildGrid()
                rebuildActiveList()
                playSFX("default")
            end)
        end
    end

