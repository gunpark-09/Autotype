local function refreshRosterUI()
    for _, c in ipairs(UI.rosterScroll:GetChildren()) do
        if c:IsA("GuiObject") and c.Name ~= "UIListLayout" then c:Destroy() end
    end
    local now = os.time()
    for u, info in pairs(S.activeUsersTable) do
        local rawU = (type(info) == "table" and info.user) or u
        local dName = (type(info) == "table" and info.disp) or u
        local t = (type(info) == "table" and info.time) or 0
        local stillInServer = (u == lp.Name:lower()) or (findPlayerCI(rawU) ~= nil)
        if stillInServer and (now - t < 180) then
            local isMuted = (S.mutedUsers[u] == true)
            local uBtn = mk("TextButton", UI.rosterScroll, { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Colors.Background, BackgroundTransparency = 0.44, Text = "      " .. dName .. (isMuted and (" [" .. sc("MUTED") .. "]") or ""), TextColor3 = isMuted and Colors.Danger or Colors.Text, Font = Enum.Font.GothamBold, TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 42, Corner = UDim.new(0, 6), Stroke = { Color = Colors.SurfaceHover, Thickness = 1 } })
            mk("Frame", uBtn, { Size = UDim2.fromOffset(6, 6), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), BackgroundColor3 = isMuted and Colors.Danger or Colors.OnlineGreen, ZIndex = 43, Corner = UDim.new(1, 0) })
            applySpringHover(uBtn)
            uBtn.MouseButton1Click:Connect(function()
                UI.rosterFrame.Visible = false
                if S.openProfile then S.openProfile(rawU, dName, S.userIdCache[rawU:lower()], isVerifiedOwner(rawU:lower()), rawU:lower() == "system") end
            end)
        else
            S.activeUsersTable[u] = nil
        end
    end
end

