        S.myRankRowObj = nil; local myRankIdx, myFolVal = #sorted, getVisualFollowerCount(myLow)
        for i, item in ipairs(sorted) do if item.lowU == myLow then myRankIdx = i; myFolVal = item.followers; break end end
        S.myRankNum = myRankIdx

        for idx = 4, math.min(100, #sorted) do
            local entry = sorted[idx]
            if entry then
                local t5 = FollowerTop5Themes[idx]; local accentCol = t5 and t5.border or Colors.Primary
                local tintA = t5 and t5.cardTintA or rgb(16, 22, 36); local tintB = t5 and t5.cardTintB or rgb(10, 12, 20)
                local isMe, isRowVerified = (entry.lowU == myLow), isVerifiedOwner(entry.lowU, S.userIdCache[entry.lowU])
                local eFol = entry.followers or 0; local relRatio = (eFol > 0) and math.clamp(eFol / topScore, 0.05, 1) or 0.03
