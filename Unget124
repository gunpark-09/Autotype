    local function applyRevoke(tLow, key, byName, mode)
        local map = S.grantedTags[tLow]
        local removedKeys = {}
        if map then
            for k, _ in pairs(map) do
                if key == "ALL" or k == key then
                    table.insert(removedKeys, k)
                end
            end
            for _, k in ipairs(removedKeys) do map[k] = nil end
        end
        local cur = S.userCustomBadges[tLow]
        if cur and (key == "ALL" or cur == key) and not isVerifiedOwner(tLow) then
            local nxt = validTagList(tLow)[1]
            S.userCustomBadges[tLow] = nxt and nxt.key or nil
        end
        if tLow == myLowName and #removedKeys > 0 and mode ~= "replay" then
            local curMine = S.currentOwnerBadge
            local wasRemoved = false
            for _, k in ipairs(removedKeys) do if k == curMine then wasRemoved = true end end
            if wasRemoved then
                local nxt = validTagList(myLowName)[1]
                S.currentOwnerBadge = nxt and nxt.key or "NONE"
                S.userCustomBadges[myLowName] = S.currentOwnerBadge
            end
            saveProfilePrefs()
            broadcastMyProfileStyle()
            if mode == "live" then
                notifyIsland("TAGLOST", "🗑️ Owner ne tumhara " .. ((key == "ALL") and "tags" or tostring(BadgePresets[key] and BadgePresets[key].Title or key)) .. " hata diya")
