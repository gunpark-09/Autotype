local function loadWebImageAsync(imgUrl, targetImageObj, onLoaded)
    if not imgUrl or imgUrl == "" then return end
    if S.webMemeCache[imgUrl] then
        if targetImageObj and targetImageObj.Parent then
            targetImageObj.Image = S.webMemeCache[imgUrl]
        end
        if onLoaded then onLoaded(S.webMemeCache[imgUrl]) end
        return
    end

    task.spawn(function()
        if not S.req or not S.getCustomAsset then return end
        local hash = 0
        for i = 1, #imgUrl do
            hash = (hash * 31 + string.byte(imgUrl, i)) % 2147483647
        end
        local lowU = imgUrl:lower()
        local ext = lowU:find("%.png") and ".png" or ".jpg"
        local filePath = "TXR_WebMemes/p_" .. tostring(hash) .. ext

        if not S.isF(filePath) then
            local waitGuard = 0
            while S.activeDownloads >= 3 and waitGuard < 40 do
                waitGuard += 1
                task.wait(0.05)
            end
            if not targetImageObj or not targetImageObj.Parent then return end

            S.activeDownloads += 1
            local ok, res = pcall(function()
                return S.req({
                    Url = imgUrl, Method = "GET",
                    Headers = { ["User-Agent"] = "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36" }
                })
            end)
            S.activeDownloads = math.max(0, S.activeDownloads - 1)

            if ok and res and (res.StatusCode == 200 or res.Status == 200) and res.Body and #res.Body > 200 then
                pcall(function() S.writeF(filePath, res.Body) end)
            end
        end

        if S.isF(filePath) then
            local okAsset, assetUri = pcall(function() return S.getCustomAsset(filePath) end)
            if okAsset and assetUri then
                S.webMemeCache[imgUrl] = assetUri
                if targetImageObj and targetImageObj.Parent then
                    targetImageObj.Image = assetUri
                end
                if onLoaded then onLoaded(assetUri) end
            end
        end
    end)
end

local function applyCustomMediaToImage(mediaVal, imgObj, fallbackUri)
    if not imgObj or not imgObj.Parent then return end
    if not mediaVal or mediaVal == "" then
        if fallbackUri then imgObj.Image = fallbackUri end
        return
    end
    if mediaVal:match("^https?://") then
        loadWebImageAsync(mediaVal, imgObj)
    else
        local digits = mediaVal:gsub("%D", "")
        if digits ~= "" then
            imgObj.Image = getAssetThumb(digits)
        elseif fallbackUri then
            imgObj.Image = fallbackUri
        end
    end
end

