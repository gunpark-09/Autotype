local function getDeterministicPoolForTarget(targetLower)
    local hash = 7
    for i = 1, #targetLower do hash = (hash * 37 + string.byte(targetLower, i)) % 1000003 end
    local copy = {}
    for i, item in ipairs(RichAccountsPool) do copy[i] = item end
    local state = hash
    for i = #copy, 2, -1 do
        state = (state * 1103515245 + 12345) % 2147483648
        local j = (state % i) + 1
        copy[i], copy[j] = copy[j], copy[i]
    end
    return copy
end

local function ensureRealFollowersPopulated(targetLower, desiredCount)
    if not targetLower or targetLower == "system" then return end
    local total = math.floor(tonumber(desiredCount) or 0)
    S.socialGraph.followers[targetLower] = S.socialGraph.followers[targetLower] or {}
    if total <= 0 then S.socialGraph.followers[targetLower] = {}; return end

    local inServerSet = {}
    for _, plr in ipairs(Svc.Players:GetPlayers()) do inServerSet[plr.Name:lower()] = true end

    for fLow, _ in pairs(S.socialGraph.followers[targetLower]) do
        if inServerSet[fLow] and not (S.socialGraph.following[fLow] and S.socialGraph.following[fLow][targetLower] == "REAL_CLICK") then
            S.socialGraph.followers[targetLower][fLow] = nil
        end
    end

    local currentCount = countMapKeys(S.socialGraph.followers[targetLower])
    local targetFill = math.min(total, 250)
    if currentCount >= targetFill then return end

    while #RichAccountsPool < targetFill + 60 do
        local newAcc = generateProceduralRichAccount(#RichAccountsPool + 1)
        table.insert(RichAccountsPool, newAcc)
        registerRichAccountIntoState(newAcc)
    end

    local deterministicCandidates = getDeterministicPoolForTarget(targetLower)
    for _, cand in ipairs(deterministicCandidates) do
        if currentCount >= targetFill then break end
        local cLow = cand.user:lower()
        if cLow ~= targetLower and not inServerSet[cLow] and not S.socialGraph.followers[targetLower][cLow] then
            registerRichAccountIntoState(cand)
            S.socialGraph.followers[targetLower][cLow] = true
            S.socialGraph.following[cLow] = S.socialGraph.following[cLow] or {}
            S.socialGraph.following[cLow][targetLower] = true
            currentCount += 1
        end
    end
end

