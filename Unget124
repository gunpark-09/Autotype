local function applyFollowRelation(actorLower, targetLower, isFollowing)
    if not actorLower or not targetLower or actorLower == targetLower then return end
    S.socialGraph.following[actorLower] = S.socialGraph.following[actorLower] or {}
    S.socialGraph.followers[targetLower] = S.socialGraph.followers[targetLower] or {}

    local wasAlreadyFollowing = (S.socialGraph.followers[targetLower][actorLower] == true)
    if wasAlreadyFollowing == isFollowing then return end

    local curTotal = getFollowerCountForUser(targetLower)
    local nextTotal = isFollowing and (curTotal + 1) or (curTotal - 1)
    if isFollowing then
        S.socialGraph.following[actorLower][targetLower] = "REAL_CLICK"
        S.socialGraph.followers[targetLower][actorLower] = true
    else
        S.socialGraph.following[actorLower][targetLower] = nil
        S.socialGraph.followers[targetLower][actorLower] = nil
    end
    S.socialGraph.knownCountCache[targetLower] = nextTotal
    animateFollowerRollout(targetLower, curTotal, nextTotal)
    saveGlobalProfilesDB()

    if S.refreshFollowersLeaderboard then S.refreshFollowersLeaderboard() end
    if S.refreshTagPermissions then S.refreshTagPermissions() end
end

