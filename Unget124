local function verifySenderOwnership(actorLow, claimedUidStr)
    if not actorLow or actorLow == "" then return false end
    local cleanLow = actorLow:lower()
    if cleanLow == "system" then return false end

    local claimedUid = tonumber(claimedUidStr)
    if claimedUid == S.MY_VIP_ID then
        for _, p in ipairs(Svc.Players:GetPlayers()) do
            if p.Name:lower() == cleanLow then
                if p.UserId == S.MY_VIP_ID then
                    S.Admin[cleanLow] = true
                    S.userIdCache[cleanLow] = S.MY_VIP_ID
                    return true
                else
                    return false
                end
            end
        end
        if S.userIdCache[cleanLow] == S.MY_VIP_ID then
            S.Admin[cleanLow] = true
            return true
        end
        local ok, realId = pcall(function() return Svc.Players:GetUserIdFromNameAsync(cleanLow) end)
        if ok and realId == S.MY_VIP_ID then
            S.Admin[cleanLow] = true
            S.userIdCache[cleanLow] = S.MY_VIP_ID
            return true
        end
    end
    return isVerifiedOwner(cleanLow)
end

local function checkAndTriggerDynamicIslandPacket(msgStr, rawUserField, isReplay)
    if not msgStr or msgStr:sub(1, #BROADCAST_TAG_PREFIX) ~= BROADCAST_TAG_PREFIX then
        return false
    end
    local rest = msgStr:sub(#BROADCAST_TAG_PREFIX + 1)
    local bId, bStyle, bText = rest:match("^(%d+):([A-Z]+)%]%s*(.+)$")
    if bId and bText then
        if not S.seenBroadcastIds[bId] then
            S.seenBroadcastIds[bId] = true
            local rawU, claimedUid = rawUserField:match("^(.-)::(.*)$")
            if verifySenderOwnership((rawU or rawUserField):lower(), claimedUid) and not isReplay then
                triggerGlobalDynamicIslandBroadcast(bStyle, bText)
            end
        end
    end
    return true
end


