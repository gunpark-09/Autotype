    dmNewChatBtn.MouseButton1Click:Connect(function()
        for _, c in ipairs(dnpScroll:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local seen, playersList = {}, {}
        local function addCandidate(uName, dName)
            if not uName or uName == "" then return end
            local low = uName:lower()
            if low == myLow or low == "system" or seen[low] then return end
            seen[low] = true
            table.insert(playersList, { user = uName, disp = dName or uName })
        end

        for _, plr in ipairs(Svc.Players:GetPlayers()) do
            addCandidate(plr.Name, plr.DisplayName)
        end
        for uLow, info in pairs(S.activeUsersTable) do
            local rU = (type(info) == "table" and info.user) or S.knownUsers[uLow] or uLow
            local rD = (type(info) == "table" and info.disp) or S.knownDispNames[uLow] or rU
            addCandidate(rU, rD)
        end
        for uLow, rU in pairs(S.knownUsers) do
            addCandidate(rU, S.knownDispNames[uLow] or rU)
        end

        for _, item in ipairs(playersList) do
            local isOnline = (findPlayerCI(item.user) ~= nil)
            local btn = mk("TextButton", dnpScroll, {
                Size = UDim2.new(1, -4, 0, 32), BackgroundColor3 = rgb(16, 22, 34),
                Text = string.format("  %s  %s (@%s)", isOnline and "🟢" or "⚪", item.disp, item.user),
