local function buildLiveBadgeElement(parentContainer, bData, zBase, customTextSize)
    local tSz = customTextSize or 10.5
    local titleStr = tostring(bData.Title or "TAG")
    local tagWidth = (#titleStr * (tSz * 0.58)) + 16
    pcall(function()
        local measured = Svc.Text:GetTextSize(titleStr, tSz, Enum.Font.GothamBlack, Vector2.new(500, 24)).X
        if measured and measured > 0 then tagWidth = measured + 14 end
    end)

    local badgeHost = mk("Frame", parentContainer, {
        Size = UDim2.fromOffset(tagWidth, customTextSize and 15 or 18),
        BackgroundColor3 = rgb(9, 13, 22), BackgroundTransparency = 0.22, BorderSizePixel = 0,
        ZIndex = zBase, Corner = UDim.new(0, 5)
    })
    local pillStroke = mk("UIStroke", badgeHost, { Thickness = 1.1, Transparency = 0.25, Color = rgb(255, 255, 255), ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
    local strokeGradGlow = mk("UIGradient", pillStroke, { Color = ColorSequence.new(bData.Colors) })

    local badgeGlow = mk("TextLabel", badgeHost, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = titleStr, TextColor3 = rgb(255, 255, 255), TextTransparency = 0.45, Font = Enum.Font.GothamBlack, TextSize = tSz, ZIndex = zBase + 1 })
    local badgeLabel = mk("TextLabel", badgeHost, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = titleStr, TextColor3 = rgb(255, 255, 255), Font = Enum.Font.GothamBlack, TextSize = tSz, ZIndex = zBase + 2 })
    local badgeShine = mk("TextLabel", badgeHost, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = titleStr, TextColor3 = rgb(255, 255, 255), Font = Enum.Font.GothamBlack, TextSize = tSz, ZIndex = zBase + 3 })

    local shineGrad = mk("UIGradient", badgeShine, { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0.0, 1), NumberSequenceKeypoint.new(0.44, 1), NumberSequenceKeypoint.new(0.5, 0.04), NumberSequenceKeypoint.new(0.56, 1), NumberSequenceKeypoint.new(1.0, 1) }) })
    local textGrad = mk("UIGradient", badgeLabel, { Color = ColorSequence.new(bData.Colors) })
    local glowGrad = mk("UIGradient", badgeGlow, { Color = ColorSequence.new(bData.Colors) })

    table.insert(S.activeBadgesList, {
        textGrad = textGrad, glowGrad = glowGrad, strokeGradGlow = strokeGradGlow,
        shineGrad = shineGrad, badgeGlow = badgeGlow,
        speed = bData.Speed or 1.15
    })
    return badgeHost
end

