    local function ensureConversationRecord(username, dispName)
        local low = tostring(username or ""):lower()
        if low == "" or low == myLow or low == "system" then return nil end
        local realUser = S.knownUsers[low] or username
        local realDisp = dispName or S.knownDispNames[low] or realUser
        if not S.dmConversations[low] then
            S.dmConversations[low] = {
                user = realUser,
                disp = realDisp,
                unread = 0,
                lastTime = os.time(),
                lastTimeStr = os.date("%H:%M"),
                lastMsg = "",
                messages = {}
            }
        else
            S.dmConversations[low].user = realUser
            if dispName and dispName ~= "" then S.dmConversations[low].disp = dispName end
        end
        return S.dmConversations[low]
    end

