        rec.scale = mk("UIScale", host, { Scale = 1 })
        rec.stroke = host:FindFirstChildOfClass("UIStroke")
        if bData.Fx == "glitch" then
            local title = tostring(bData.Title or "TAG")
            local function ghost(col)
                return mk("TextLabel", host, {
                    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = title, TextColor3 = col,
                    TextTransparency = 0.35, Font = Enum.Font.GothamBlack, TextSize = tSz, ZIndex = zBase + 1
                })
            end
            rec.gR = ghost(rgb(255, 40, 70))
            rec.gC = ghost(rgb(0, 240, 255))
        end
        table.insert(S.activeFxList, rec)
    end
    buildLiveBadgeElement = function(parentContainer, bData, zBase, customTextSize)
        local host = origBuild(parentContainer, bData, zBase, customTextSize)
        if host and bData and bData.Fx then
