    local function isTagValid(low, key)
        local map = S.grantedTags[low]
        local rec = map and map[key]
        if not rec then return false end
        if rec.exp and rec.exp ~= 0 and rec.exp <= nowSec() then return false end
        return true
    end
    local function validTagList(low)
        local out = {}
        local map = S.grantedTags[low]
        if map then
            for key, rec in pairs(map) do
                if isTagValid(low, key) then table.insert(out, { key = key, rec = rec }) end
            end
        end
        table.sort(out, function(a, b) return (a.rec.t or 0) > (b.rec.t or 0) end)
        return out
    end
    local function getGlowRec(low)
        if not low then return nil end
        local rec = S.profileGlow[low]
        if rec and rec.style == 0 then return nil end
        if rec and rec.style and rec.style > 0 and (not rec.exp or rec.exp == 0 or rec.exp > nowSec()) then return rec end
        if isVerifiedOwner(low) then return { style = 1, exp = 0, by = "OWNER" } end
        return nil
    end

