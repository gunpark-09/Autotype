local RenderedCardKeys = {}

S.sendMessageFunc = function(overrideText)
    if isLocalPlayerMuted() then UI.chatInput.Text = ""; S.updateMuteLockUI(); return end
    local text = overrideText or UI.chatInput.Text
    if not text then return end
    if text == "TextBox" then text = "" end
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" or (tick() - S.lastSendTick < 0.15) then return end
    S.lastSendTick = tick(); UI.autoCompleteBar.Visible = false

    local lowText = text:lower()
    local isOwner = isVerifiedOwner(lp.Name:lower(), lp.UserId)
    local currentScope = (S.chatMode == "rank" or S.chatMode == "extra") and "global" or S.chatMode

    local muteTarget = text:match("^!mute%s+@?([%w_]+)")
    if muteTarget then
        UI.chatInput.Text = ""
        if isOwner then
            if isVerifiedOwner(muteTarget:lower()) then addMessageToFeed("System::" .. BRAND_TITLE, "⚠️ Cannot mute Owner.", nil, false, game.JobId, currentScope)
            else setGlobalMuteState(muteTarget, true, true); addMessageToFeed("System::" .. BRAND_TITLE, "🔇 @" .. muteTarget .. " has been MUTED globally until unmuted.", nil, false, game.JobId, currentScope) end
        end
        return
    end

    local unmuteTarget = text:match("^!unmute%s+@?([%w_]+)")
    if unmuteTarget then
        UI.chatInput.Text = ""
        if isOwner then setGlobalMuteState(unmuteTarget, false, true); addMessageToFeed("System::" .. BRAND_TITLE, "🔊 @" .. unmuteTarget .. " has been UNMUTED and can chat again.", nil, false, game.JobId, currentScope) end
        return
    end

    local pMatch = text:match("^!p%s+([%w_]+)")
    if pMatch then
        UI.chatInput.Text = ""
        if S.openDmConversationRoom then S.openDmConversationRoom(pMatch, S.knownDispNames[pMatch:lower()] or pMatch) end
        return
    end

    if lowText == "/help" or lowText == "!help" then
        UI.chatInput.Text = ""
        local helpStr = "Commands: '@ai <msg>' for Live AI | '!p <user>' for Private DM | Double-Tap any message to Heart."
        if isOwner then helpStr = helpStr .. " | Owner: '!mute <user>' & '!unmute <user>' | Open any profile & tap '👑 +FOL'!" end
        addMessageToFeed("System::" .. BRAND_TITLE, helpStr, nil, false, game.JobId, currentScope)
        return
    end

    if S.activeEditData then
        local formattedBody = sanitizeXml(text):gsub("(@%w+)", "<font color='#FFCD46'><b>%1</b></font>")
        S.activeEditData.label.Text = formattedBody .. "  <font color='#8A9AB5' size='9'><i>(" .. sc("edited") .. ")</i></font>"
        clearReplyBanner(); UI.chatInput.Text = ""; playSFX("default"); return
    end

    local payloadBodyText = text
    if S.activeReplyData then
        payloadBodyText = string.format("[REP:%s|%s] %s", S.activeReplyData.disp, S.activeReplyData.text, text)
        clearReplyBanner()
    end

    -- Generate unique client nonce so our own echoed packet from server NEVER renders twice!
    local clientNonce = string.format("%s_%d_%d", lp.Name:lower(), math.floor(tick() * 1000), math.random(1000, 9999))
    S.localSentNonces[clientNonce] = tick()

    local finalMsg = payloadBodyText
    if S.chatMode == "dm" and S.activeDmChatUser then
        S.privateTarget = S.activeDmChatUser
    end

    if S.privateTarget then
        if S.onBeforeSendDm then
            local allowed = S.onBeforeSendDm(S.privateTarget, payloadBodyText, clientNonce)
            if not allowed then return end
        end
        finalMsg = string.format("( 🔐 %s Private %s) [NID:%s] %s", lp.Name, S.privateTarget, clientNonce, payloadBodyText)
           clearReplyBanner()
    end

    -- Generate unique client nonce so our own echo never duplicates in Global/Server feed
    local clientNonce = string.format("%s_%d_%d", lp.Name, math.floor(tick() * 1000), math.random(10000, 99999))
    S.localSentNonces[clientNonce] = tick()

    local finalMsg = payloadBodyText
    if S.chatMode == "dm" and S.activeDmChatUser then
        S.privateTarget = S.activeDmChatUser
    end

    if S.privateTarget then
        if S.onBeforeSendDm then
            local allowed = S.onBeforeSendDm(S.privateTarget, payloadBodyText)
            if not allowed then return end
        end
        finalMsg = string.format("( 🔐 %s Private %s) [NID:%s] %s", lp.Name, S.privateTarget, clientNonce, payloadBodyText)
        currentScope = "dm"
        if S.chatMode ~= "dm" then switchChatTab("dm") end
    else
        if currentScope == "dm" then
            addMessageToFeed("System::" .. BRAND_TITLE, "Select a player first via DM Inbox -> '+ NEW DM' or Profile -> DM.", nil, false, game.JobId, "dm")
            return
        end
        finalMsg = (currentScope == "server")
            and string.format("[SRV:%s] [NID:%s] %s", tostring(game.JobId), clientNonce, payloadBodyText)
            or string.format("[GLB] [NID:%s] %s", clientNonce, payloadBodyText)
    end

    if not overrideText then UI.chatInput.Text = "" end
    local encodedUserTag = lp.Name .. "::" .. lp.DisplayName
    local genMsgId = encodedUserTag .. "_" .. clientNonce .. "_" .. payloadBodyText

    if S.privateTarget then
        addMessageToFeed(encodedUserTag, payloadBodyText, S.privateTarget, true, game.JobId, "dm", nil, genMsgId)
    else
        addMessageToFeed(encodedUserTag, payloadBodyText, nil, false, game.JobId, currentScope, nil, genMsgId)
        if currentScope == "global" then
            saveGlobalMessageToDisk(encodedUserTag, payloadBodyText, genMsgId)
        end
    end
    displayBubble(lp.Name, text)

    if text:lower():match("^[@/]ai") then
        handleSmartAIQuery(text)
    end

    local localEchoSig = encodedUserTag .. "::" .. finalMsg
    S.recentLocalSentMap[localEchoSig] = (S.recentLocalSentMap[localEchoSig] or 0) + 1

    task.spawn(function()
        if S.req then
            local payload = Svc.Http:JSONEncode({ user = encodedUserTag, msg = finalMsg, jobId = game.JobId })
            pcall(function()
                S.req({
                    Url = S.SERVER_URL .. "/send", Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = payload
                })
            end)
        end
    end)
