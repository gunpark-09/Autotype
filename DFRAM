local function mk(cls, parent, props)
    local inst = Instance.new(cls)
    if props then
        for k, v in pairs(props) do
            if k == "Corner" then
                Instance.new("UICorner", inst).CornerRadius = v
            elseif k == "Stroke" then
                local st = Instance.new("UIStroke", inst)
                st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                for sk, sv in pairs(v) do st[sk] = sv end
            else
                inst[k] = v
            end
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function makeSeq(cols)
    local pts = {}
    for i, c in ipairs(cols) do
        table.insert(pts, csk((i - 1) / math.max(1, #cols - 1), c))
    end
    return ColorSequence.new(pts)
end

