game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.OnMessageDoneFiltering.OnClientEvent:Connect(function(msg)
    if msg.Message:lower():find("^!spam") then
        currentSpamText = msg.Message:sub(7)
        addChatMessage("Spam set: " .. currentSpamText, true)
    elseif msg.Message:lower():find("^!delay") then
        local delay = tonumber(msg.Message:sub(8))
        if delay then
            spamDelay = delay
            addChatMessage("Spam delay set to: " .. delay, true)
        end
    elseif msg.Message:lower():find("^!ai add") then
        local feature = msg.Message:sub(9)
        addChatMessage("AI Feature Added: " .. feature, true)
    end
end)

