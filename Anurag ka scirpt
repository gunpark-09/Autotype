-- ================== FUNCTIONS ==================
local function addChatMessage(msg, isOwner)
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 0, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.TextWrapped = true
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextSize = 14
    msgLabel.RichText = true
    
    if isOwner then
        msgLabel.TextColor3 = OwnerRGB
        msgLabel.Text = "<b>[OWNER]</b> " .. msg
    else
        msgLabel.TextColor3 = Color3.new(1,1,1)
        msgLabel.Text = msg
    end
    
    msgLabel.Parent = ChatFrame
    ChatFrame.CanvasPosition = Vector2.new(0, ChatFrame.AbsoluteCanvasSize.Y)
end

local function announceExecution()
    local tag = Admins[Username] and "Admin" or "User"
    addChatMessage(Username .. " " .. tag .. " has executed " .. ScriptName, true)
end

-- AI Call
local function callAI(prompt)
    local data = {
        model = "llama3-70b-8192",
        messages = {{role = "user", content = prompt}},
        temperature = 0.7,
        max_tokens = 300
    }
    
    local success, response = pcall(function()
        return HttpService:PostAsync(GROQ_API, HttpService:JSONEncode(data), Enum.HttpContentType.ApplicationJson, false, {["Authorization"] = "Bearer " .. AI_API_KEY})
    end)
    
    if success then
        local decoded = HttpService:JSONDecode(response)
        return decoded.choices[1].message.content
    end
    return "AI Error"
end

-- Spam Function
local function startSpam()
    isSpamming = true
    spawn(function()
        while isSpamming do
            game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(currentSpamText, "All")
            wait(spamDelay)
        end
    end)
end

