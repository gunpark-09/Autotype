local function applyOwnerGrantState(kind, targetLower, itemKey, actionMode, expTs)
    if not targetLower or targetLower == "" or targetLower == "system" then return end
    local isGrant = (actionMode == "GRANT")
    local expNum = tonumber(expTs) or 0

    if kind == "TAG" then
        S.grantedUserTags[targetLower] = S.grantedUserTags[targetLower] or {}
        if isGrant then
            S.grantedUserTags[targetLower][itemKey] = expNum
            S.userCustomBadges[targetLower] = itemKey
            if targetLower == lp.Name:lower() then
                S.currentOwnerBadge = itemKey
            end
        else
            S.grantedUserTags[targetLower][itemKey] = nil
            if S.userCustomBadges[targetLower] == itemKey then
                S.userCustomBadges[targetLower] = "NONE"
            end
            if targetLower == lp.Name:lower() and S.currentOwnerBadge == itemKey then
                S.currentOwnerBadge = "NONE"
            end
        end
    elseif kind == "GLOW" then
        S.grantedUserGlows[targetLower] = S.grantedUserGlows[targetLower] or {}
        S.userProfiles[targetLower] = S.userProfiles[targetLower] or {
            bio = "TXR ReChat Network Member.",
            mood = "⚡ " .. sc("ACTIVE"),
            themeIdx = 1,
            customAv = "",
            customBan = "",
            profileGlow = "NONE"
        }
        if isGrant then
            S.grantedUserGlows[targetLower][itemKey] = expNum
            S.userProfiles[targetLower].profileGlow = itemKey
            if targetLower == lp.Name:lower() then
                S.myProfileGlow = itemKey
            end
        else
            S.grantedUserGlows[targetLower][itemKey] = nil
            if S.userProfiles[targetLower].profileGlow == itemKey then
                S.userProfiles[targetLower].profileGlow = "NONE"
            end
            if targetLower == lp.Name:lower() and S.myProfileGlow == itemKey then
                S.myProfileGlow = "NONE"
            end
        end
    end

    saveProfilePrefs()
    if S.refreshTagPermissions then S.refreshTagPermissions() end
    if S.refreshCurrentOpenProfile then S.refreshCurrentOpenProfile() end
end

local function ownerDispatchTagOrGlow(kind, targetUser, itemKey, actionMode, durationSec)
    if not isVerifiedOwner(lp.Name:lower(), lp.UserId) then return end
    local tUser = targetUser or lp.Name
    local tLow = tUser:lower()
    if tLow == "system" then return end

    local dur = math.max(0, math.floor(tonumber(durationSec) or 0))
    local expTs = (actionMode == "GRANT" and dur > 0) and (os.time() + dur) or 0

    applyOwnerGrantState(kind, tLow, itemKey, actionMode, expTs)
    if tLow == lp.Name:lower() then
