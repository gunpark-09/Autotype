    end)

    local isUniqueEmp = (bData.UniqueEMP == true)
    local badgeHost = mk("Frame", parentContainer, {
        Size = UDim2.fromOffset(tagWidth, customTextSize and 15 or 18),
        BackgroundColor3 = isUniqueEmp and rgb(24, 8, 16) or rgb(9, 13, 22),
        BackgroundTransparency = isUniqueEmp and 0.08 or 0.22,
        BorderSizePixel = 0, ZIndex = zBase, Corner = UDim.new(0, 5)
    })

    if isUniqueEmp then
        mk("UIGradient", badgeHost, {
            Rotation = 15,
            Color = ColorSequence.new({ csk(0, rgb(64, 14, 28)), csk(0.5, rgb(18, 14, 28)), csk(1, rgb(12, 36, 48)) })
        })
    end

