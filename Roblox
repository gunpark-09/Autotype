                Size = UDim2.fromScale(1, 1), BackgroundColor3 = theme.accent, BorderSizePixel = 0, ZIndex = 104, Corner = UDim.new(1, 0)
            })

            Svc.Tween:Create(island, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0, 14)
            }):Play()

            task.wait(0.34)
            capsuleTitle.Visible = false
            expandedWrap.Visible = true

            Svc.Tween:Create(island, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(374, 74)
            }):Play()

            local displayDuration = 8.5
            Svc.Tween:Create(progFill, TweenInfo.new(displayDuration, Enum.EasingStyle.Linear), {
                Size = UDim2.new(0, 0, 1, 0)
            }):Play()

            local dismissed = false
            local function dismissIsland()
                if dismissed then return end
                dismissed = true
                playSFX("default")
                expandedWrap.Visible = false
                capsuleTitle.Visible = true
                Svc.Tween:Create(island, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    Size = UDim2.fromOffset(124, 28)
