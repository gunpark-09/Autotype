local function updateLiveCounter(username, dispName, packetJobId)
    local lowU = username:lower()
    if lowU == "system" then return end

    if packetJobId and tostring(packetJobId) ~= "" and tostring(packetJobId) ~= tostring(game.JobId) then
        return
    end
    local stillInServer = (lowU == lp.Name:lower()) or (Svc.Players:FindFirstChild(username) ~= nil)
    if not stillInServer then
        return
    end

    S.activeUsersTable[lowU] = { time = os.time(), disp = dispName or username, user = username }
    S.knownUsers[lowU] = username
    if dispName then S.knownDispNames[lowU] = dispName end

    local count, now = 0, os.time()
    for u, data in pairs(S.activeUsersTable) do
        local t = (type(data) == "table" and data.time) or data
        local rawU = (type(data) == "table" and data.user) or u
        local inSrv = (u == lp.Name:lower()) or (Svc.Players:FindFirstChild(rawU) ~= nil)
        if inSrv and (now - t < 180) then
            count = count + 1
        else
            S.activeUsersTable[u] = nil
        end
    end
    UI.liveText.Text = string.format("%d %s", math.max(1, count), sc("ACTIVE"))
end

Svc.Players.PlayerRemoving:Connect(function(plr)
    if _G.TXR_ChatInstanceID ~= currentExecutionID or not UI.gui.Parent then return end
    local lowU = plr.Name:lower()
    S.sessionJoinShown[lowU] = nil
    if S.activeUsersTable[lowU] then
