                })

                mk("TextLabel", row, {
                    Size = UDim2.fromOffset(28, 36), Position = UDim2.fromOffset(7, 1), BackgroundTransparency = 1,
                    Text = "#" .. tostring(idx), TextColor3 = accentCol, Font = Enum.Font.GothamBlack,
                    TextSize = (idx >= 100) and 8.6 or 10.0, ZIndex = 19
                })

                local rAv = mk("ImageLabel", row, {
                    Size = UDim2.fromOffset(26, 26), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 36, 0.5, -1),
                    BackgroundColor3 = rgb(6, 8, 14), ScaleType = Enum.ScaleType.Crop, ZIndex = 19, Corner = UDim.new(1, 0)
                })
                bindAvatarToImage(entry.lowU, entry.user, rAv)

                local rNameRow = mk("Frame", row, {
                    Size = UDim2.new(0.50, 0, 0, 15), Position = UDim2.new(0, 68, 0, 3),
                    BackgroundTransparency = 1, ZIndex = 19
                })
                mk("UIListLayout", rNameRow, {
                    FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
                    Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder
                })

                mk("TextLabel", rNameRow, {
                    AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 1,
                    Text = entry.disp .. " (@" .. entry.user .. ")",
                    TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold,
                    TextSize = 9.2, LayoutOrder = 1, ZIndex = 19
                })
                if isRowVerified then
                    createVerifiedBlueTick(rNameRow, 12, 20, 2)
                end

                if t5 then
                    local bHolder = mk("Frame", row, { Size = UDim2.fromOffset(110, 15), Position = UDim2.new(0, 68, 0, 19), BackgroundTransparency = 1, ZIndex = 19 })
                    buildLiveBadgeElement(bHolder, { Title = t5.title, Speed = t5.speed, Colors = t5.colors }, 19, 7.6)
                else
                    local pill = mk("Frame", row, {
                        Size = UDim2.fromOffset(106, 15), Position = UDim2.new(0, 68, 0, 19),
                        BackgroundColor3 = rgb(18, 24, 38), ZIndex = 18, Corner = UDim.new(1, 0),
                        Stroke = { Color = accentCol, Thickness = 0.85, Transparency = 0.25 }
                    })
                    mk("TextLabel", pill, {
                        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                        Text = (idx <= 100) and (sc("RISING STAR #") .. tostring(idx)) or sc("MEMBER"),
                        TextColor3 = accentCol, Font = Enum.Font.GothamBlack, TextSize = 7.6, ZIndex = 19
                    })
                end

                local pTrack = mk("Frame", row, {
                    Size = UDim2.new(1, -76, 0, 2.5), Position = UDim2.new(0, 68, 1, -4),
                    BackgroundColor3 = rgb(6, 8, 14), BorderSizePixel = 0, ZIndex = 18, Corner = UDim.new(1, 0)
                })
                mk("Frame", pTrack, {
                    Size = UDim2.new(relRatio, 0, 1, 0), BackgroundColor3 = (eFol < 0) and Colors.Danger or accentCol,
                    BorderSizePixel = 0, ZIndex = 19, Corner = UDim.new(1, 0)
                })

                mk("TextLabel", row, {
                    Size = UDim2.new(0.24, -8, 1, -4), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0),
                    BackgroundTransparency = 1, Text = string.format("%d %s", eFol, sc("FOL")),
                    TextColor3 = (eFol < 0) and Colors.Danger or rgb(240, 248, 255), Font = Enum.Font.Code, TextSize = 9.4,
                    TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 19
                })

                row.MouseButton1Click:Connect(function()
                    if S.openProfile then
                        S.openProfile(entry.user, entry.disp, S.userIdCache[entry.lowU], isVerifiedOwner(entry.lowU), false)
                    end
                end)
            end
        end

        myRankPosLbl.Text = string.format("%s #%d", sc("YOU"), myRankIdx)
        for _, ch in ipairs(myRankBadgeHost:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end
        local myT5 = FollowerTop5Themes[myRankIdx]
        if myT5 and myFolVal > 0 then
            local b = buildLiveBadgeElement(myRankBadgeHost, { Title = myT5.title, Speed = myT5.speed, Colors = myT5.colors }, 20, 8.0)
            b.AnchorPoint = Vector2.new(0, 0.5); b.Position = UDim2.new(0, 0, 0.5, 0)
        else
            local b = buildLiveBadgeElement(myRankBadgeHost, {
                Title = (myRankIdx <= 100) and (sc("TOP #") .. tostring(myRankIdx)) or sc("UNRANKED"),
                Speed = 1.1,
                Colors = { csk(0, Colors.Primary), csk(0.5, Colors.Purple), csk(1, Colors.Primary) }
            }, 20, 8.0)
            b.AnchorPoint = Vector2.new(0, 0.5); b.Position = UDim2.new(0, 0, 0.5, 0)
        end

        myRankGapLbl.TextColor3 = (myFolVal < 0) and Colors.Danger or Colors.OnlineGreen
        if myRankIdx > 1 and sorted[myRankIdx - 1] then
            local gap = math.max(1, (sorted[myRankIdx - 1].followers - myFolVal) + 1)
            myRankGapLbl.Text = string.format("%d %s (+%d)", myFolVal, sc("FOL"), gap)
        else
            myRankGapLbl.Text = string.format("%d %s ★", myFolVal, sc("FOL"))
        end
    end

