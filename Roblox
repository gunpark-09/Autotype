local function saveGlobalMessageToDisk(userTag, cleanMsg, msgIdKey)
    for _, item in ipairs(_G.TXR_GlobalHistoryCache) do
        if item.key == msgIdKey then return end
    end
    table.insert(_G.TXR_GlobalHistoryCache, { user = userTag, msg = cleanMsg, key = msgIdKey, t = os.date("%H:%M") })
    while #_G.TXR_GlobalHistoryCache > 200 do table.remove(_G.TXR_GlobalHistoryCache, 1) end
    pcall(function() S.writeF(S.GLOBAL_SAVE_FILE, Svc.Http:JSONEncode(_G.TXR_GlobalHistoryCache)) end)
end

local function isInternalAlienPacket(msgStr)
    if not msgStr then return true end
    return msgStr:sub(1, 5) == "[EMP_"
end

local function displayBubble(userName, msg)
    if S.mutedUsers[userName:lower()] then return end
    local speaker = Svc.Players:FindFirstChild(userName)
    if not speaker or not speaker.Character then return end
    local cleanMsg = (msg:find("%[MEME:") or msg:find("%[WEBMEME:")) and "[Meme Sticker]" or msg
    pcall(function()
        if Svc.TextChat.ChatVersion == Enum.ChatVersion.TextChatService then
            Svc.TextChat:DisplayBubble(speaker.Character, cleanMsg)
        else
            local head = speaker.Character:FindFirstChild("Head")
            if head then Svc.Chat:Chat(head, cleanMsg, Enum.ChatColor.White) end
        end
    end)
end

