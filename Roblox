    local function searchProfilePinterestMedia(rawQ, appendMore)
        S.profMediaSearchToken += 1
        local tok = S.profMediaSearchToken
        local q = (rawQ or pmsSearchBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")

        local searchQuery = q
        if searchQuery == "" then
            searchQuery = (S.profMediaTarget == "AVATAR")
                and "most popular viral aesthetic dark anime pfp 4k"
                or "most popular aesthetic cyberpunk dark banner wallpaper 4k"
        else
            searchQuery = "popular viral " .. q .. ((S.profMediaTarget == "AVATAR") and " aesthetic pfp icon 4k" or " aesthetic banner header 4k")
        end

        if not appendMore then
            S.profMediaItems = {}
            S.profMediaPageIdx = 1
            S.profMediaWebOffset = 1
            for _, c in ipairs(pmsGrid:GetChildren()) do
                if c:IsA("ImageButton") then c:Destroy() end
            end
        end

        pmsSpinnerLbl.Text = sc("Loading popular...")
        pmsSpinnerOverlay.Visible = true

        fetchPinterestBatch(searchQuery, S.profMediaWebOffset, function(urls)
            if S.profMediaSearchToken ~= tok then return end
            pmsSpinnerOverlay.Visible = false
            local seen = {}
            for _, u in ipairs(S.profMediaItems) do seen[u] = true end
            for _, u in ipairs(urls) do
                if not seen[u] then
                    seen[u] = true
                    table.insert(S.profMediaItems, u)
                end
            end
            S.profMediaWebOffset += 36
            if appendMore and #urls > 0 then
                S.profMediaPageIdx += 1
            end
            renderProfileMediaPage()
        end, function()
            return S.profMediaSearchToken == tok
        end)
    end

