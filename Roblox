        end

        if tick() >= nextRankSyncTick then
            nextRankSyncTick = tick() + 22
            if S.req then
                pcall(function()
                    local myLow = lp.Name:lower()
                    local myFolCount = getFollowerCountForUser(myLow)
                    S.req({
                        Url = S.SERVER_URL .. "/send", Method = "POST",
                        Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                        Body = Svc.Http:JSONEncode({
                            user = lp.Name .. "::" .. lp.DisplayName,
                            msg = string.format("__FOL_RANK__:%d|%s", myFolCount, tostring(lp.UserId)),
                            jobId = game.JobId,
                            hidden = true
                        })
                    })
                end)
            end
        end

        local now = tick()
        local activeTypersList = {}
        for u, info in pairs(S.remoteTypers) do
            if now - info.t < 3.0 and info.scope == S.chatMode then table.insert(activeTypersList, info.disp) else S.remoteTypers[u] = nil end
        end
        if #activeTypersList > 0 then
            UI.ltpLabel.Text = (#activeTypersList == 1) and (activeTypersList[1] .. " " .. sc("is typing...")) or (tostring(#activeTypersList) .. " " .. sc("people typing..."))
            UI.liveTypingPill.Visible = true
        else
            UI.liveTypingPill.Visible = false
        end

        if S.req and not S.isInitialSync then
            local ok, res = pcall(function() return S.req({ Url = S.SERVER_URL .. "/messages?since=" .. tostring(S.lastSyncTime), Method = "GET", Headers = { ["User-Agent"] = "Roblox/WinInet" } }) end)
            if ok and res and res.Body then
                local parseOk, data = pcall(function() return Svc.Http:JSONDecode(res.Body) end)
                if parseOk and type(data) == "table" and #data > 0 then
                    for _, item in ipairs(data) do
                        local itemId = tonumber(item.id) or 0
                        if itemId > S.lastSyncTime then S.lastSyncTime = itemId end
                        local rawU = item.user or "Unknown"
                        local msg = item.msg or ""
                        local job = tostring(item.jobId or "")

                        if isInternalAlienPacket(msg) then continue end

                        local bId, bStyle, bTxt = msg:match("^%[EMP_ANNOUNCE_" .. S.UPDATE_CAMPAIGN_ID .. ":([^:]+):([^%]]+)%]%s*(.*)$")
                        if bId and bStyle and bTxt then
                            local senderName, senderUid = rawU:match("^(.-)::(%d+)$")
                            if senderName and isVerifiedOwner(senderName:lower(), tonumber(senderUid)) and not S.seenBroadcastIds[bId] then
                                S.seenBroadcastIds[bId] = true
                                triggerGlobalDynamicIslandBroadcast(bStyle, bTxt)
                            end
                            continue
                        end

                        local baseUser, dispName, _, privTarget = rawU:match("^(.-)::(.-)::(PRIV)::(.*)$")
                        if not baseUser then
                            baseUser, dispName = rawU:match("^(.-)::(.*)$")
                            if not baseUser then baseUser = rawU; dispName = rawU end
                        end

                        local isSystem = (baseUser == "System")
                        local lowBase = baseUser:lower()
                        local isSameServer = (job == tostring(game.JobId)) and (Svc.Players:FindFirstChild(baseUser) ~= nil or lowBase == lp.Name:lower())

                        if not isSystem then
                            if isSameServer then
                                updateLiveCounter(baseUser, dispName, job)
                            else
                                S.knownUsers[lowBase] = baseUser
                                if dispName then S.knownDispNames[lowBase] = dispName end
                            end
                        end

                        if msg:sub(1, 11) == "__TYPING__:" then
                            if lowBase ~= lp.Name:lower() then
                                local tScope = msg:sub(12)
                                if tScope == "global" or (tScope == "server" and isSameServer) then
                                    S.remoteTypers[lowBase] = { disp = dispName, t = tick(), scope = tScope }
                                end
                            end
                        elseif msg:sub(1, 10) == "__REACT__:" then
                            local rMsgId, rEmoji = msg:sub(11):match("^([^|]+)|(.+)$")
                            if rMsgId and rEmoji and S.cardReactionHooks[rMsgId] then
                                S.cardReactionHooks[rMsgId](rEmoji)
                            end
                        elseif msg:sub(1, 13) == "__GRANT_FX__:" then
                            local kind, tLow, itemKey, actionMode, expStr, senderUidStr = msg:sub(14):match("^([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)$")
                            if kind and tLow and itemKey and actionMode and isVerifiedOwner(lowBase, tonumber(senderUidStr)) then
                                applyOwnerGrantState(kind, tLow, itemKey, actionMode, tonumber(expStr) or 0)
                            end
                        elseif msg:sub(1, 12) == "__GLOW_SET__:" then
                            local glowKey, senderUidStr = msg:sub(13):match("^([^|]+)|([^|]+)$")
                            if glowKey and lowBase ~= lp.Name:lower() and ProfileGlowPresets[glowKey] then
                                if isVerifiedOwner(lowBase, tonumber(senderUidStr)) or userHasGrantedGlow(lowBase, glowKey) then
                                    S.userProfiles[lowBase] = S.userProfiles[lowBase] or { bio = "TXR ReChat Network Member.", mood = "⚡ " .. sc("ACTIVE"), themeIdx = 1, customAv = "", customBan = "", profileGlow = "NONE" }
                                    S.userProfiles[lowBase].profileGlow = glowKey
                                    saveGlobalProfilesDB()
                                    if S.refreshCurrentOpenProfile then S.refreshCurrentOpenProfile() end
                                end
                            end
                        elseif msg:sub(1, 12) == "__MUTE_SET__:" then
                            local targetLow, stateStr, senderUidStr = msg:sub(13):match("^([^|]+)|([^|]+)|([^|]+)$")
                            if targetLow and stateStr and isVerifiedOwner(lowBase, tonumber(senderUidStr)) then
                                setGlobalMuteState(targetLow, stateStr == "1", false)
                            end
                        elseif msg:sub(1, 11) == "__TAG_SET__:" then
                            local tagKey, senderUidStr = msg:sub(12):match("^([^|]+)|([^|]+)$")
                            if tagKey and lowBase ~= lp.Name:lower() then
                                if isVerifiedOwner(lowBase, tonumber(senderUidStr)) or canUserEquipTag(lowBase, tagKey) then
                                    S.userCustomBadges[lowBase] = tagKey
                                    saveGlobalProfilesDB()
                                end
                            end
                        elseif msg:sub(1, 11) == "__FOL_SET__:" then
                            local targetLow, newCntStr, targetUidStr, senderUidStr = msg:sub(12):match("^([^|]+)|([^|]+)|([^|]+)|([^|]+)$")
                            local newCnt = math.floor(tonumber(newCntStr) or 0)
                            local tUid = tonumber(targetUidStr)
                            local sUid = tonumber(senderUidStr)
                            if targetLow and isVerifiedOwner(lowBase, sUid) then
                                if tUid and tUid > 0 then S.userIdCache[targetLow] = tUid end
                                local oldVal = getFollowerCountForUser(targetLow)
                                if newCnt > 0 then
                                    ensureRealFollowersPopulated(targetLow, newCnt)
                                else
                                    S.socialGraph.followers[targetLow] = {}
                                end
                                S.socialGraph.knownCountCache[targetLow] = newCnt
                                animateFollowerRollout(targetLow, oldVal, newCnt)
                                saveProfilePrefs()
                                if S.refreshFollowersLeaderboard then S.refreshFollowersLeaderboard() end
                                if S.refreshProfileSocialUI then S.refreshProfileSocialUI() end
                                if S.refreshTagPermissions then S.refreshTagPermissions() end
                            end
                        elseif msg:sub(1, 12) == "__FOL_RANK__:" then
                            local folCntStr, uidStr = msg:sub(13):match("^([^|]+)|([^|]+)$")
                            local folCnt = math.floor(tonumber(folCntStr) or 0)
                            local senderUid = tonumber(uidStr)
                            if lowBase ~= lp.Name:lower() then
                                if senderUid then S.userIdCache[lowBase] = senderUid end
                                local prevCnt = getFollowerCountForUser(lowBase)
                                if folCnt > 0 then
                                    ensureRealFollowersPopulated(lowBase, folCnt)
                                else
                                    S.socialGraph.followers[lowBase] = {}
                                end
                                S.socialGraph.knownCountCache[lowBase] = folCnt
                                animateFollowerRollout(lowBase, prevCnt, folCnt)
                                saveGlobalProfilesDB()
                                if S.refreshFollowersLeaderboard then S.refreshFollowersLeaderboard() end
                                if S.refreshProfileSocialUI then S.refreshProfileSocialUI() end
                                if S.refreshTagPermissions then S.refreshTagPermissions() end
                            end
                        elseif msg:sub(1, 12) == "__FOL_SYNC__:" then
                            local targetLow, tgtCntStr, actCntStr = msg:sub(13):match("^([^|]+)|([^|]+)|([^|]+)$")
                            local tgtCnt = math.floor(tonumber(tgtCntStr) or 0)
                            local actCnt = math.floor(tonumber(actCntStr) or 0)
                            if targetLow then
                                local prevTgt = getFollowerCountForUser(targetLow)
                                S.socialGraph.knownCountCache[targetLow] = tgtCnt
                                if tgtCnt > 0 then ensureRealFollowersPopulated(targetLow, tgtCnt) else S.socialGraph.followers[targetLow] = {} end
                                animateFollowerRollout(targetLow, prevTgt, tgtCnt)
                            end
                            if lowBase ~= lp.Name:lower() then
                                local prevAct = getFollowerCountForUser(lowBase)
                                S.socialGraph.knownCountCache[lowBase] = actCnt
                                if actCnt > 0 then ensureRealFollowersPopulated(lowBase, actCnt) else S.socialGraph.followers[lowBase] = {} end
                                animateFollowerRollout(lowBase, prevAct, actCnt)
                            end
                            saveGlobalProfilesDB()
                            if S.refreshFollowersLeaderboard then S.refreshFollowersLeaderboard() end
                            if S.refreshProfileSocialUI then S.refreshProfileSocialUI() end
                            if S.refreshTagPermissions then S.refreshTagPermissions() end
                        elseif msg:sub(1, 10) == "__FOLLOW__:" then
                            local targetLow, stateStr = msg:sub(11):match("^([^|]+)|([^|]+)$")
                            if targetLow and lowBase ~= lp.Name:lower() then
                                applyFollowRelation(lowBase, targetLow, stateStr == "1")
                            end
                        elseif msg:sub(1, 14) == "__PROF_STYLE__:" then
                            local cIdxStr, mTxt, avTxt, banTxt, bTxt = msg:sub(15):match("^([^|]+)|([^|]*)|([^|]*)|([^|]*)|(.*)$")
                            local cIdx = tonumber(cIdxStr)
                            if cIdx and ProfilePalettes[cIdx] and lowBase ~= lp.Name:lower() then
                                local existingGlow = (S.userProfiles[lowBase] and S.userProfiles[lowBase].profileGlow) or "NONE"
                                S.userProfiles[lowBase] = {
                                    bio = (bTxt ~= "" and bTxt) or "TXR ReChat Network Member.",
                                    mood = (mTxt ~= "" and mTxt) or ("⚡ " .. sc("ACTIVE")),
                                    themeIdx = cIdx,
                                    customAv = avTxt or "",
                                    customBan = banTxt or "",
                                    profileGlow = existingGlow
                                }
                                refreshUserAvatarsInFeed(lowBase)
                                saveGlobalProfilesDB()
                                if S.refreshCurrentOpenProfile then S.refreshCurrentOpenProfile() end
                            end
                        elseif msg == "__HEARTBEAT__" then
                            if lowBase ~= lp.Name:lower() and isSameServer and not S.sessionJoinShown[lowBase] then
                                S.sessionJoinShown[lowBase] = true
                                addJoinNotice(dispName, "server")
                                broadcastMyProfileStyle()
                            end
                        else
                            if not isSystem and not isVerifiedOwner(lowBase) and S.mutedUsers[lowBase] then
                                continue
                            end

                            local packetMsgId = tostring(item.msgId or item.id or "")
                            local localSentKey = lowBase .. "_" .. msg
                            local wasSentLocally = (lowBase == lp.Name:lower() or isSystem) and S.recentLocalSentMap[localSentKey] and (tick() - S.recentLocalSentMap[localSentKey] < 12)

                            local isDupId = (packetMsgId ~= "") and (S.processedServerMessageMap[packetMsgId] == true)
                            if packetMsgId ~= "" then S.processedServerMessageMap[packetMsgId] = true end

                            local isGlobalMsg = (item.scope == "global") or (job == "GLOBAL")
                            if privTarget then
                                if not isDupId and not wasSentLocally then
                                    if privTarget:lower() == lp.Name:lower() then
                                        addMessageToFeed(baseUser .. "::" .. dispName, msg, privTarget, false, job, "dm", nil, packetMsgId)
                                        playSFX("dm")
                                        if S.chatMode ~= "dm" then
                                            S.unreadDmCount += 1
                                            UI.dmUnreadTxt.Text = (S.unreadDmCount > 9) and "9+" or tostring(S.unreadDmCount)
                                            UI.dmUnreadPill.Visible = true
                                        end
                                        if UI.openBtnContainer.Visible then
                                            S.unreadCount += 1
                                            UI.unreadTxt.Text = (S.unreadCount > 9) and "9+" or tostring(S.unreadCount)
                                            UI.unreadBadge.Visible = true
                                            spawnSonar(Colors.Purple)
                                            triggerOrbToast("DM • " .. dispName, msg)
                                        end
                                    elseif lowBase == lp.Name:lower() then
                                        addMessageToFeed(baseUser .. "::" .. dispName, msg, privTarget, true, job, "dm", nil, packetMsgId)
                                    end
                                end
                            elseif isGlobalMsg then
                                saveGlobalMessageToDisk(baseUser .. "::" .. dispName, msg, packetMsgId)
                                if not isDupId and not wasSentLocally then
                                    addMessageToFeed(baseUser .. "::" .. dispName, msg, nil, false, "GLOBAL", "global", nil, packetMsgId)
                                    if UI.openBtnContainer.Visible and lowBase ~= lp.Name:lower() then
                                        S.unreadCount += 1
                                        UI.unreadTxt.Text = (S.unreadCount > 9) and "9+" or tostring(S.unreadCount)
                                        UI.unreadBadge.Visible = true
                                        spawnSonar(Colors.Primary)
                                        triggerOrbToast(dispName, msg)
                                    end
                                end
                            elseif isSameServer then
                                if not isDupId and not wasSentLocally then
                                    addMessageToFeed(baseUser .. "::" .. dispName, msg, nil, false, job, "server", nil, packetMsgId)
                                    if lowBase ~= lp.Name:lower() then
                                        if not isSystem then displayBubble(baseUser, msg) end
                                        if UI.openBtnContainer.Visible then
                                            S.unreadCount += 1
                                            UI.unreadTxt.Text = (S.unreadCount > 9) and "9+" or tostring(S.unreadCount)
                                            UI.unreadBadge.Visible = true
                                            spawnSonar(Colors.Primary)
                                            triggerOrbToast(dispName, msg)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.85)
    end
end)
