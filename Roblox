        if cachedFol > 0 then
            ensureRealFollowersPopulated(lowU, cachedFol)
        end

        local targetThemeIdx = isMyOwn and S.myProfileColorIdx or ((profData and profData.themeIdx) or (isAI and 3 or 1))
        renderProfilePalette(targetThemeIdx)
        pColorPickerBtn.Visible = isMyOwn
