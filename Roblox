    local function renderFollowersLeaderboard()
        local usersSet = {}
        local myLow = lp.Name:lower()
        usersSet[myLow] = { lowU = myLow, user = lp.Name, disp = lp.DisplayName }

        for _, plr in ipairs(Svc.Players:GetPlayers()) do
            local pLow = plr.Name:lower()
            S.userIdCache[pLow] = plr.UserId
            usersSet[pLow] = { lowU = pLow, user = plr.Name, disp = plr.DisplayName }
        end

        for uLow, info in pairs(S.activeUsersTable) do
            if uLow ~= "system" then
                usersSet[uLow] = {
                    lowU = uLow,
                    user = (type(info) == "table" and info.user) or uLow,
                    disp = (type(info) == "table" and info.disp) or S.knownDispNames[uLow] or uLow
                }
            end
        end
        for uLow, _ in pairs(S.socialGraph.knownCountCache) do
            if uLow ~= "system" and not usersSet[uLow] then
                usersSet[uLow] = { lowU = uLow, user = S.knownUsers[uLow] or uLow, disp = S.knownDispNames[uLow] or S.knownUsers[uLow] or uLow }
            end
        end

        local sorted = {}
        for _, entry in pairs(usersSet) do
            entry.followers = getVisualFollowerCount(entry.lowU)
            entry.sortScore = getFollowerCountForUser(entry.lowU)
            table.insert(sorted, entry)
        end

        table.sort(sorted, function(a, b)
            if a.sortScore == b.sortScore then
                if a.lowU == myLow then return true end
                if b.lowU == myLow then return false end
                return a.disp:lower() < b.disp:lower()
            end
            return a.sortScore > b.sortScore
        end)

        local topScore = math.max(1, sorted[1] and sorted[1].followers or 1)

        for place = 1, 3 do
            local slot = podiumSlots[place]
            local pData = sorted[place]
            slot.data = pData
            if pData then
                local shortDisp = pData.disp
                if #shortDisp > 12 then shortDisp = string.sub(shortDisp, 1, 11) .. ".." end
                slot.name.Text = shortDisp
                slot.name.TextColor3 = Color3.new(1, 1, 1)
                slot.tick.Visible = isVerifiedOwner(pData.lowU, S.userIdCache[pData.lowU])
                slot.score.Text = string.format("%d %s", pData.followers, sc("FOL"))
                slot.score.TextColor3 = (pData.followers < 0) and Colors.Danger or FollowerTop5Themes[place].border
                bindAvatarToImage(pData.lowU, pData.user, slot.avatar)
            else
                slot.name.Text = sc("OPEN SLOT")
                slot.name.TextColor3 = Colors.SubText
                slot.tick.Visible = false
                slot.score.Text = "0 " .. sc("FOL")
                slot.avatar.Image = "rbxthumb://type=AvatarHeadShot&id=9685785248&w=100&h=100"
            end
        end

        for _, ch in ipairs(rkScroll:GetChildren()) do
            if ch:IsA("GuiObject") and ch.Name ~= "UIListLayout" then ch:Destroy() end
        end

        S.myRankRowObj = nil
        local myRankIdx = #sorted
        local myFolVal = getVisualFollowerCount(myLow)
        for i, item in ipairs(sorted) do
            if item.lowU == myLow then
                myRankIdx = i
                myFolVal = item.followers
                break
            end
        end
        S.myRankNum = myRankIdx

        local maxDraw = math.min(100, #sorted)
        for idx = 4, maxDraw do
            local entry = sorted[idx]
            if entry then
                local t5 = FollowerTop5Themes[idx]
                local accentCol = t5 and t5.border or Colors.Primary
                local tintA = t5 and t5.cardTintA or rgb(16, 22, 36)
                local tintB = t5 and t5.cardTintB or rgb(10, 12, 20)
                local isMe = (entry.lowU == myLow)
                local isRowVerified = isVerifiedOwner(entry.lowU, S.userIdCache[entry.lowU])
                local eFol = entry.followers or 0
                local relRatio = (eFol > 0) and math.clamp(eFol / topScore, 0.05, 1) or 0.03

                local row = mk("TextButton", rkScroll, {
                    Size = UDim2.new(1, -4, 0, 42), BackgroundColor3 = Color3.new(1, 1, 1),
                    BackgroundTransparency = 0.08, Text = "", AutoButtonColor = false, LayoutOrder = idx,
                    ClipsDescendants = true, ZIndex = 16, Corner = UDim.new(0, 9)
                })
                applySpringHover(row)
                if isMe then S.myRankRowObj = row end

                mk("UIGradient", row, {
                    Rotation = 15,
                    Color = ColorSequence.new({ csk(0, isMe and rgb(20, 38, 62) or tintA), csk(1, tintB) })
                })
                mk("UIStroke", row, { Thickness = (t5 or isMe) and 1.15 or 0.85, Color = accentCol, Transparency = (t5 or isMe) and 0.15 or 0.45, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

                mk("Frame", row, {
                    Size = UDim2.new(0, 3, 1, -10), Position = UDim2.new(0, 3, 0, 5),
