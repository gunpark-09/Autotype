    local function bindAvatarToImage(lowU, rawU, imgObj)
        local prof = S.userProfiles[lowU]
        if prof and prof.customAv and prof.customAv ~= "" then
            applyCustomMediaToImage(prof.customAv, imgObj)
            return
        end
        local uid = S.userIdCache[lowU]
        if uid then
            imgObj.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", uid)
        else
            imgObj.Image = "rbxthumb://type=AvatarHeadShot&id=9685785248&w=100&h=100"
            task.spawn(function()
                local ok, fetched = pcall(function() return Svc.Players:GetUserIdFromNameAsync(rawU) end)
                if ok and fetched then
                    S.userIdCache[lowU] = fetched
                    if imgObj and imgObj.Parent then
                        imgObj.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", fetched)
                    end
                end
            end)
        end
