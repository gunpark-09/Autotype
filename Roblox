local function broadcastReactionPacket(msgId, emojiStr)
    if not msgId or msgId == "" then return end
    task.spawn(function()
        if S.req then
            pcall(function()
                S.req({
                    Url = S.SERVER_URL .. "/send", Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = Svc.Http:JSONEncode({
                        user = lp.Name .. "::" .. lp.DisplayName,
                        msg = string.format("__REACT__:%s|%s", tostring(msgId), tostring(emojiStr)),
                        jobId = game.JobId,
                        hidden = true
                    })
                })
            end)
        end
    end)
end

