local function updateAutoComplete(currentText)
    local lastWord = currentText:match("(%S+)$")
    if not lastWord then hideAutoComplete(); return end
    local results = {}
    local firstChar = lastWord:sub(1, 1)

    if firstChar == "@" then
        local query = lastWord:sub(2):lower()
        table.insert(results, { label = "@ai  (" .. sc("Ask AI") .. ")", insert = "@ai ", isSpecial = true })
        if isVerifiedOwner(lp.Name:lower(), lp.UserId) then
            table.insert(results, { label = "@all  (" .. sc("Alert") .. ")", insert = "@all ", isSpecial = true })
        end
        for u, dName in pairs(S.knownDispNames) do
            local rawU = S.knownUsers[u] or u
            if rawU:lower() ~= lp.Name:lower() and (query == "" or rawU:lower():find(query, 1, true) or dName:lower():find(query, 1, true)) then
                table.insert(results, { label = string.format("%s (@%s)", dName, rawU), insert = "@" .. rawU .. " " })
            end
        end
    elseif firstChar == "!" and lastWord == currentText then
        local cmds = {
            { cmd = "!p ", desc = sc("Private DM") },
            { cmd = "!g ", desc = sc("Global Chat") },
            { cmd = "!s ", desc = sc("Server Chat") }
