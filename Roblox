-- ✅ 100% Pure A-Z & a-z Styling (Only Standard A and a Letters - Zero Boxes Guarantee!)
local function styleRichDisplayName(baseName, variantSeed)
    local mode = variantSeed % 7
    if mode == 0 then
        return baseName
    elseif mode == 1 then
        return baseName:upper()
    elseif mode == 2 then
        return baseName:lower()
    elseif mode == 3 then
        local spaced = baseName:upper():gsub("(.)", "%1 "):gsub("%s+$", "")
        return spaced
    elseif mode == 4 then
        return "i" .. baseName
    elseif mode == 5 then
        return "x" .. baseName
    else
        local out = ""
        local idx = 0
        for ch in baseName:gmatch(".") do
            if ch:match("%a") then
                idx += 1
                out = out .. ((idx % 2 == 1) and ch:upper() or ch:lower())
            else
                out = out .. ch
            end
        end
        return out
    end
end

