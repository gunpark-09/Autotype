local function formatTimeRemaining(expTs)
    local exp = tonumber(expTs) or 0
    if exp == 0 then return sc("PERMANENT") end
    local rem = math.max(0, math.floor(exp - os.time()))
    if rem <= 0 then return sc("EXPIRED") end
    if rem >= 86400 then
        return string.format("%dd %dh", math.floor(rem / 86400), math.floor((rem % 86400) / 3600))
    elseif rem >= 3600 then
        return string.format("%dh %dm", math.floor(rem / 3600), math.floor((rem % 3600) / 60))
    elseif rem >= 60 then
        return string.format("%dm %ds", math.floor(rem / 60), rem % 60)
    else
        return string.format("%ds", rem)
    end
end

