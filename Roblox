    end
    local copy = {}
    for i, item in ipairs(RichAccountsPool) do
        copy[i] = item
    end
    local state = hash
    for i = #copy, 2, -1 do
        state = (state * 1103515245 + 12345) % 2147483648
        local j = (state % i) + 1
        copy[i], copy[j] = copy[j], copy[i]
    end
