-- =========================================================
S.sendChatMessage = function(overrideText)
    if S.mutedUsers[lp.Name:lower()] and not isVerifiedOwner(lp.Name:lower(), lp.UserId) then
        if S.updateMuteLockUI then S.updateMuteLockUI() end
        return
    end

    local rawText = overrideText or UI.chatInput.Text
    if not rawText or rawText:gsub("%s+", "") == "" then return end

    if S.activeEditData and not overrideText then
        local bodyObj = S.activeEditData.bodyObj
        if bodyObj and bodyObj.Parent then
            local editedFormatted = sanitizeXml(rawText):gsub("(@%w+)", "<font color='#FFCD46'><b>%1</b></font>")
            bodyObj.Text = editedFormatted .. "  <font color='#7F8FA6'><i>(" .. sc("edited") .. ")</i></font>"
        end
        UI.chatInput.Text = ""; clearContextBanner(); playSFX("default")
        return
    end

    if tick() - S.lastSendTick < 0.25 then return end
    S.lastSendTick = tick()
    if not overrideText then UI.chatInput.Text = "" end
    hideAutoComplete()

    local isGlobalMsg, privUser, cleanMsg = (S.chatMode == "global"), S.privateTarget, rawText
    local pTarget, pText = rawText:match("^!p%s+(%S+)%s+(.+)$")
    if pTarget and pText then privUser, cleanMsg = pTarget, pText
    elseif rawText:sub(1, 3) == "!g " then isGlobalMsg, privUser, cleanMsg = true, nil, rawText:sub(4)
    elseif rawText:sub(1, 3) == "!s " then isGlobalMsg, privUser, cleanMsg = false, nil, rawText:sub(4) end

    local replyPrefix = ""
    if S.activeReplyData then
        replyPrefix = string.format("[REP:%s|%s] ", S.activeReplyData.dispName, S.activeReplyData.snippet)
        clearContextBanner()
    end

    local finalPayloadText = replyPrefix .. cleanMsg
    local targetScope = privUser and "dm" or (isGlobalMsg and "global" or "server")
    local localUniqueId = string.format("%s_%d_%d", lp.Name:lower(), math.floor(tick() * 1000), math.random(100, 999))

    S.recentLocalSentMap[lp.Name:lower() .. "_" .. finalPayloadText] = tick()
    addMessageToFeed(lp.Name .. "::" .. lp.DisplayName, finalPayloadText, privUser, true, game.JobId, targetScope, nil, localUniqueId)
    if not privUser and targetScope == "server" then displayBubble(lp.Name, cleanMsg) end
    if targetScope == "global" and not privUser then
        saveGlobalMessageToDisk(lp.Name .. "::" .. lp.DisplayName, finalPayloadText, localUniqueId)
    end
    playSFX("default")

    local packedUser = lp.Name .. "::" .. lp.DisplayName .. (privUser and ("::PRIV::" .. privUser) or "")
    local payload = Svc.Http:JSONEncode({
        user = packedUser,
        msg = finalPayloadText,
        jobId = isGlobalMsg and "GLOBAL" or game.JobId,
        scope = targetScope,
        hidden = (privUser ~= nil),
        msgId = localUniqueId
    })

    task.spawn(function()
        if S.req then pcall(function() S.req({ Url = S.SERVER_URL .. "/send", Method = "POST", Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" }, Body = payload }) end) end
    end)

    if string.find(string.lower(cleanMsg), "@ai", 1, true) then
        task.spawn(function()
            if S.req then pcall(function()
                local aiQuestion = cleanMsg:gsub("@[aA][iI]", ""):gsub("^%s+", "")
                if aiQuestion == "" then aiQuestion = "Hello! Who are you?" end
                local aiRes = S.req({
                    Url = S.SERVER_URL .. "/ask_ai", Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = Svc.Http:JSONEncode({ user = lp.DisplayName, prompt = aiQuestion, jobId = game.JobId })
                })
                if aiRes and aiRes.Body then
                    local okJ, dec = pcall(function() return Svc.Http:JSONDecode(aiRes.Body) end)
                    if okJ and dec and dec.reply then
                        local aiText = "[REP:" .. lp.DisplayName .. "|" .. cleanMsg:sub(1, 28) .. "] " .. dec.reply
                        local aiMsgId = "sys_" .. tostring(math.floor(tick() * 1000)) .. "_" .. tostring(math.random(100, 999))
                        S.recentLocalSentMap["system_" .. aiText] = tick()
                        addMessageToFeed("System::" .. BRAND_TITLE, aiText, privUser, false, game.JobId, targetScope, nil, aiMsgId)
                        S.req({
                            Url = S.SERVER_URL .. "/send", Method = "POST",
                            Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                            Body = Svc.Http:JSONEncode({
                                user = "System::" .. BRAND_TITLE .. (privUser and ("::PRIV::" .. privUser) or ""),
                                msg = aiText,
                                jobId = isGlobalMsg and "GLOBAL" or game.JobId,
                                scope = targetScope,
                                hidden = (privUser ~= nil),
                                msgId = aiMsgId
                            })
                        })
                    end
                end
            end) end
        end)
    end
end

