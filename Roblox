local function applySpringHover(btn)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    local origTrans = btn.BackgroundTransparency
    local hoverTrans = math.max(0, origTrans - 0.15)
    btn.MouseEnter:Connect(function()
        Svc.Tween:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.05}):Play()
        Svc.Tween:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {BackgroundTransparency = hoverTrans}):Play()
    end)
    btn.MouseLeave:Connect(function()
        Svc.Tween:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
        Svc.Tween:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {BackgroundTransparency = origTrans}):Play()
    end)
    btn.MouseButton1Down:Connect(function() Svc.Tween:Create(btnScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), {Scale = 0.94}):Play() end)
    btn.MouseButton1Up:Connect(function() Svc.Tween:Create(btnScale, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1.05}):Play() end)
end

local function playSFX(soundType)
    task.spawn(function()
