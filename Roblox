local function getFilteredMemeItems()
    local q = UI.memeSearchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
    local combined = {}
    local seen = {}

    for _, m in ipairs(VerifiedMemePool) do
        local catOk = (S.memeFilterCat == "ALL") or (m.cat == S.memeFilterCat)
        local matchQ = (q == "") or m.name:lower():find(q, 1, true) or m.tags:lower():find(q, 1, true)
        if catOk and matchQ then
            local k = m.url or tostring(m.assetId)
            if not seen[k] then
                seen[k] = true
                table.insert(combined, m)
            end
        end
    end

    if S.memeFilterCat ~= "INDIAN" then
        for _, m in ipairs(S.imgflipPool) do
            if q == "" or m.name:lower():find(q, 1, true) then
                if not seen[m.url] then
                    seen[m.url] = true
                    table.insert(combined, m)
                end
            end
        end
    end

    for _, wm in ipairs(S.liveWebMemes) do
        if wm.url and not seen[wm.url] then
            seen[wm.url] = true
            table.insert(combined, wm)
        end
    end
    return combined
end

local function renderMemePage()
    for _, c in ipairs(UI.memeGrid:GetChildren()) do
        if c:IsA("ImageButton") then c:Destroy() end
    end
    local items = getFilteredMemeItems()
    local totalPages = math.max(1, math.ceil(#items / 8))
    S.memePageIdx = math.clamp(S.memePageIdx, 1, totalPages)

    memePageLbl.Text = string.format("%s %d / %d  •  %d", sc("PAGE"), S.memePageIdx, totalPages, #items)
    memePrevBtn.TextTransparency = (S.memePageIdx > 1) and 0 or 0.55

    local startIdx = (S.memePageIdx - 1) * 8 + 1
    local endIdx = math.min(#items, startIdx + 7)
    for i = startIdx, endIdx do
        if items[i] then
            createMemeTile(items[i])
        end
    end
end

local function triggerLiveWebMemeSearch(rawQuery, appendMore)
    S.memeSearchToken += 1
    local myToken = S.memeSearchToken
    local cleanQ = (rawQuery or ""):gsub("^%s+", ""):gsub("%s+$", "")

    if not appendMore then
        S.liveWebMemes = {}
        S.memePageIdx = 1
        S.memeWebOffset = 1
    end

    renderMemePage()
    local currentCount = #getFilteredMemeItems()
    if currentCount == 0 or appendMore then
        UI.memeSpinnerLbl.Text = sc("Loading popular...")
        UI.memeSpinnerOverlay.Visible = true
    end

    local queryStr
    if cleanQ == "" then
        queryStr = (S.memeFilterCat == "INDIAN") and "most popular viral indian bollywood funny meme template" or "most popular viral trending funny meme template"
    else
        queryStr = "popular viral " .. cleanQ .. ((S.memeFilterCat == "INDIAN") and " indian funny meme" or " funny meme template")
    end

    fetchPinterestBatch(queryStr, S.memeWebOffset, function(urls)
        if S.memeSearchToken ~= myToken then return end
        UI.memeSpinnerOverlay.Visible = false
        local seen = {}
        for _, m in ipairs(S.liveWebMemes) do seen[m.url] = true end
        for _, u in ipairs(urls) do
            if not seen[u] then
                seen[u] = true
                table.insert(S.liveWebMemes, { name = (cleanQ ~= "" and cleanQ or sc("Trending")), url = u, cat = S.memeFilterCat, tags = cleanQ })
            end
        end
        S.memeWebOffset += 36
        if appendMore and #urls > 0 then
            S.memePageIdx += 1
        end
        renderMemePage()
    end, function()
        return S.memeSearchToken == myToken
    end)
end

