                    Position = UDim2.new(0.5, 0, 0, -55)
                }):Play()
                task.delay(0.26, function()
                    if bGui and bGui.Parent then bGui:Destroy() end
                end)
            end

            island.MouseButton1Click:Connect(dismissIsland)

            local clk = 0
            local hbConn
            hbConn = Svc.Run.Heartbeat:Connect(function(dt)
                if not bGui or not bGui.Parent or dismissed then
                    if hbConn then hbConn:Disconnect() end
                    return
                end
                clk += dt
                iStrokeGrad.Rotation = (clk * 75) % 360
                avRingGrad.Rotation = -(clk * 110) % 360
                liveTag.TextTransparency = 0.1 + ((math.sin(clk * 5) + 1) / 2) * 0.65
                local swPos = ((clk * 0.55) % 2.6) - 1.3
                swGrad.Offset = Vector2.new(swPos, 0)
            end)

            task.delay(displayDuration, dismissIsland)
        end)
    end)
end

