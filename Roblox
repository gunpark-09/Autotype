        for _, ch in ipairs(pBadgeSlot:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end

        local rawProfileDisp = dispName or S.knownDispNames[lowU] or username
        pName.Text = (isAI or Svc.Players:FindFirstChild(username)) and rawProfileDisp or cleanPureAlphabetName(rawProfileDisp, username)
        pUser.Text = isAI and "@TXR_SystemCore" or ("@" .. username)
        pInstaBlueTick.Visible = (userIsOwner or isAI)

        local customBanner = isMyOwn and S.myCustomBanner or (profData and profData.customBan)
        if customBanner and customBanner ~= "" then
            pCustomBannerImg.Visible = true
            applyCustomMediaToImage(customBanner, pCustomBannerImg)
        else
            pCustomBannerImg.Visible = false
        end

        local inServerPlr = not isAI and Svc.Players:FindFirstChild(username)
        if isAI then
            pPresLbl.Text = sc("SYSTEM CORE")
            UI.pmPresDot.BackgroundColor3 = Colors.InstaBlue
            pAvatar.Image = ""
            pAvatar.Visible = false
            pAiEmblem.Visible = true
            pMoodPill.Text = sc("ONLINE 24/7")
            local b = buildLiveBadgeElement(pBadgeSlot, BadgePresets["AICORE"], 307)
            b.Parent = pBadgeSlot
        else
            pAiEmblem.Visible = false
            pAvatar.Visible = true

            if inServerPlr then
                pPresLbl.Text = sc("IN SERVER")
                UI.pmPresDot.BackgroundColor3 = Colors.OnlineGreen
                uId = inServerPlr.UserId
            else
                pPresLbl.Text = sc("GLOBAL NET")
                UI.pmPresDot.BackgroundColor3 = (ProfilePalettes[targetThemeIdx] or ProfilePalettes[1]).main
