local function animateFollowerRollout(userLower, fromVal, toVal)
    if not userLower then return end
    S.followerRollTokens[userLower] = (S.followerRollTokens[userLower] or 0) + 1
    local myToken = S.followerRollTokens[userLower]

    if fromVal == toVal then
        S.visualFollowerDisplay[userLower] = toVal
        return
    end

    task.spawn(function()
        local diff = math.abs(toVal - fromVal)
        local duration = math.clamp(0.45 + math.min(diff, 500) * 0.0022, 0.55, 2.2)
        local startT = tick()
        while S.followerRollTokens[userLower] == myToken and _G.TXR_ChatInstanceID == currentExecutionID do
            local elapsed = tick() - startT
            local alpha = math.clamp(elapsed / duration, 0, 1)
            local eased = 1 - ((1 - alpha) ^ 3)
            local curVal = fromVal + (toVal - fromVal) * eased
            S.visualFollowerDisplay[userLower] = curVal

            if S.refreshProfileSocialUI and S.activeProfileUser and S.activeProfileUser:lower() == userLower then
                S.refreshProfileSocialUI()
            end
            if S.updateBoostHeaderStat and (S.boostTargetUser or lp.Name):lower() == userLower then
                S.updateBoostHeaderStat()
            end
            if S.refreshFollowersLeaderboard then
                S.refreshFollowersLeaderboard(false)
            end

            if alpha >= 1 then
                S.visualFollowerDisplay[userLower] = toVal
                if S.refreshProfileSocialUI and S.activeProfileUser and S.activeProfileUser:lower() == userLower then
                    S.refreshProfileSocialUI()
                end
                if S.updateBoostHeaderStat and (S.boostTargetUser or lp.Name):lower() == userLower then
                    S.updateBoostHeaderStat()
                end
                if S.refreshFollowersLeaderboard then
                    S.refreshFollowersLeaderboard(true)
                end
                break
            end
            task.wait(0.025)
        end
    end)
end

local function getGlobalFollowerRankForUser(targetLower)
    if not targetLower or targetLower == "system" then return nil end
    local usersSet = {}
    local myLow = lp.Name:lower()
    usersSet[myLow] = true

    for uLow, _ in pairs(S.activeUsersTable) do
        if uLow ~= "system" then usersSet[uLow] = true end
    end
    for uLow, _ in pairs(S.userProfiles) do
        if uLow ~= "system" then usersSet[uLow] = true end
    end
    for uLow, _ in pairs(S.socialGraph.followers) do
        if uLow ~= "system" then usersSet[uLow] = true end
    end
    for uLow, _ in pairs(S.socialGraph.knownCountCache) do
        if uLow ~= "system" then usersSet[uLow] = true end
    end
    usersSet[targetLower] = true

    local arr = {}
    for uLow, _ in pairs(usersSet) do
        table.insert(arr, { lowU = uLow, followers = getFollowerCountForUser(uLow) })
    end

    table.sort(arr, function(a, b)
        if a.followers == b.followers then
            if a.lowU == myLow then return true end
            if b.lowU == myLow then return false end
            return a.lowU < b.lowU
        end
        return a.followers > b.followers
    end)

    for idx, item in ipairs(arr) do
        if item.lowU == targetLower then
            return idx
        end
    end
    return #arr
end

local function getRankExclusiveTagKey(userLower)
