-- Apply spoof function
local function applySpoof()
    local newName = NameBox.Text
    if newName == nil or newName == "" then
        newName = originalName
    end
    
    local finalName = newName
    if activeFont then
        finalName = activeFont.convert(newName)
    end
    
    spoofedName = finalName
    
    if rgbEnabled then
        local r, g, b = 255, 0, 0
        local function updateColor()
            if not isActive then return end
            r = (r + 5) % 255
            g = (g + 3) % 255
            b = (b + 7) % 255
            lp.DisplayName = '<font color="rgb(' .. r .. ',' .. g .. ',' .. b .. ')">' .. spoofedName .. '</font>'
            task.wait(0.05)
            if rgbEnabled and isActive then updateColor() end
        end
        coroutine.wrap(updateColor)()
    elseif displayNameColor ~= "default" then
        local colorCode = colorCodes[displayNameColor].code
        lp.DisplayName = '<font color="#' .. colorCode .. '">' .. spoofedName .. '</font>'
    else
        lp.DisplayName = spoofedName
    end
    
    isActive = true
    StatusLabel.Text = "✅ Status: Active - " .. spoofedName
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
end

ApplyBtn.MouseButton1Click:Connect(applySpoof)

