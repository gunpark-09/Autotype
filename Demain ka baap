-- Update preview with font
local function updatePreviewWithFont(text)
    if text == nil or text == "" then
        text = "YourName"
    end
    local finalText = text
    if activeFont then
        finalText = activeFont.convert(text)
    end
    
    if rgbEnabled then
        local colorText = ""
        for i = 1, #finalText do
            local char = finalText:sub(i, i)
            local color = rgbColors[(i-1) % #rgbColors + 1]
            colorText = colorText .. '<font color="#' .. color .. '">' .. char .. '</font>'
        end
        PreviewLabel.Text = "Preview: " .. colorText
        PreviewLabel.RichText = true
    elseif displayNameColor ~= "default" then
        local colorCode = colorCodes[displayNameColor].code
        PreviewLabel.Text = 'Preview: <font color="#' .. colorCode .. '">' .. finalText .. '</font>'
        PreviewLabel.RichText = true
    else
        PreviewLabel.Text = "Preview: " .. finalText
        PreviewLabel.RichText = false
    end
end

